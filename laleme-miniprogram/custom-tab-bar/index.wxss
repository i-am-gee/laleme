/* ============================================================
   自定义 tabBar · iOS Tab Bar 体例
   ============================================================ */

.tabbar {
    /* 自定义 tabBar 独立渲染，这里本地兜底一份令牌，避免继承不到 */
    --sep: rgba(60, 58, 55, 0.12);
    --label-3: rgba(60, 58, 55, 0.32);
    --tint: #8b5e3c;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    display: flex;
    background: #ffffff;
    /* iOS 用一条 0.5px 发丝线分隔，不用投影 */
    border-top: 0.5rpx solid var(--sep);
    padding-bottom: env(safe-area-inset-bottom);
}

.tab {
    flex: 1;
    height: 118rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s var(--ease-spring), opacity 0.12s ease;
}

.tab.pressed {
    transform: scale(0.92);
    opacity: 0.72;
}

.tab-icon {
    width: 56rpx;
    height: 56rpx;
}

.tab-text {
    font-size: 24rpx;
    color: var(--label-3);
    margin-top: 4rpx;
    line-height: 1.2;
    letter-spacing: 0.2rpx;
}

.tab.active .tab-text {
    color: var(--tint);
    font-weight: 600;
}
