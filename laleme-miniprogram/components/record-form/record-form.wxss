/* ============================================================
   记录表单 · iOS 体例
   ============================================================ */

.form {
    /* 组件兜底令牌，避免继承不到 page 上的变量 */
    --bg-card: #ffffff;
    --fill-1: rgba(120, 104, 88, 0.07);
    --label: #1c1c1e;
    --label-2: rgba(60, 58, 55, 0.6);
    --label-3: rgba(60, 58, 55, 0.32);
    --tint: #8b5e3c;
    --tint-strong: #6f4b30;
    --red: #ff3b30;
    --r-sm: 16rpx;
    --r-md: 24rpx;
    --r-full: 999rpx;
    --sp-1: 8rpx;
    --sp-2: 16rpx;
    --sp-3: 24rpx;
    --sp-4: 32rpx;
    --sp-5: 48rpx;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    padding: var(--sp-1) var(--sp-4) var(--sp-5);
}

/* ---------- 计时区：淡填充块 ---------- */
.timer-box {
    background: var(--fill-1);
    border-radius: var(--r-md);
    padding: var(--sp-3);
    text-align: center;
    margin-bottom: var(--sp-3);
}

.t-display {
    font-size: var(--t-title1);
    font-weight: 600;
    color: var(--tint-strong);
    font-variant-numeric: tabular-nums;
    letter-spacing: 1rpx;
    line-height: 1.15;
}

.manual-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
}

.manual-input {
    width: 128rpx;
    padding: 10rpx;
    border: none;
    border-radius: 12rpx;
    font-size: var(--t-footnote);
    text-align: center;
    background: var(--bg-card);
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.manual-tip {
    font-size: var(--t-caption);
    color: var(--label-2);
}

/* ---------- 性状网格：四列，选中态抬起 ---------- */
.bs-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
}

.bs-item {
    width: calc((100% - 48rpx) / 4);
    box-sizing: border-box;
    background: var(--fill-1);
    border: none;
    border-radius: var(--r-sm);
    padding: 14rpx 0;
    text-align: center;
    transition: transform 0.2s var(--ease-spring), background-color 0.18s ease, box-shadow 0.18s ease;
}

.bs-item:active {
    transform: scale(0.95);
}

.bs-item.sel {
    background: var(--bg-card);
    box-shadow: 0 0 0 3rpx var(--tint) inset, 0 4rpx 14rpx rgba(80, 50, 20, 0.10);
}

.bs-num {
    font-size: var(--t-callout);
    font-weight: 600;
    color: var(--label-2);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
}

.bs-item.sel .bs-num {
    color: var(--tint);
}

.bs-name {
    font-size: var(--t-caption2);
    color: var(--label-3);
    margin-top: 2rpx;
    line-height: 1.3;
}

.bs-item.sel .bs-name {
    color: var(--label-2);
}

/* 理想型：绿色语义提示 */
.bs-item.ideal .bs-num {
    color: #248a63;
}

.bs-item.ideal.sel {
    box-shadow: 0 0 0 3rpx #248a63 inset, 0 4rpx 14rpx rgba(36, 138, 99, 0.12);
}

.bs-item.ideal.sel .bs-num {
    color: #248a63;
}

.bs-hint {
    font-size: var(--t-caption);
    color: var(--label-2);
    margin-top: var(--sp-2);
    min-height: 32rpx;
    line-height: 1.45;
}

/* ---------- 感受 ---------- */
.mood-row {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
}

.mood-item {
    flex: 1;
    background: var(--fill-1);
    border: none;
    border-radius: var(--r-sm);
    padding: var(--sp-2) 0;
    text-align: center;
    font-size: var(--t-footnote);
    color: var(--label-2);
    transition: transform 0.2s var(--ease-spring), background-color 0.18s ease, box-shadow 0.18s ease;
}

.mood-item:active {
    transform: scale(0.96);
}

.mood-item.sel {
    background: var(--bg-card);
    color: var(--tint);
    font-weight: 600;
    box-shadow: 0 0 0 3rpx var(--tint) inset, 0 4rpx 14rpx rgba(80, 50, 20, 0.10);
}

/* ---------- 时间选择 ---------- */
.dt-row {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
}

.picker-half {
    flex: 1;
}

.picker-value {
    background: var(--fill-1);
    border-radius: var(--r-sm);
    padding: var(--sp-2);
    font-size: var(--t-footnote);
    color: var(--label);
    text-align: center;
    font-variant-numeric: tabular-nums;
}

/* ---------- 按钮 ---------- */
.primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100% !important;
    height: 100rpx;
    margin-top: var(--sp-4);
    padding: 0;
    border: none;
    border-radius: var(--r-full);
    background: var(--tint);
    color: #ffffff;
    font-size: var(--t-body);
    font-weight: 600;
    letter-spacing: 0.5rpx;
    box-sizing: border-box;
    box-shadow: 0 10rpx 28rpx rgba(139, 94, 60, 0.22);
    transition: transform 0.2s var(--ease-spring), opacity 0.12s ease;
}

.primary-btn::after {
    border: none;
}

.primary-hover {
    transform: scale(0.97);
    opacity: 0.9;
}

.danger-link {
    text-align: center;
    font-size: var(--t-subhead);
    color: var(--red);
    padding: var(--sp-3) 0 4rpx;
}
