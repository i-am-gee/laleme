/* ---------- 感受：与「颜色」同一套盒子，图标更大一号 ---------- */
.mood-row {
    display: flex;
    gap: var(--sp-2);
}

.mood-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6rpx;
    padding: 10rpx 0 8rpx;
    border-radius: var(--r-sm);
    background: var(--fill-1);
    border: none;
    box-shadow: 0 0 0 3rpx transparent inset;
    transition: transform 0.2s var(--ease-spring), background-color 0.18s ease, box-shadow 0.18s ease;
}

.mood-item:active {
    transform: scale(0.95);
}

.mood-item.sel {
    background: var(--bg-card);
    box-shadow: 0 0 0 3rpx var(--tint) inset, 0 4rpx 14rpx rgba(80, 50, 20, 0.10);
}

.mood-icon {
    display: block;
    width: 84rpx;
    height: 84rpx;
}

.mood-text {
    font-size: 20rpx;
    line-height: 1.2;
    color: var(--label-3);
}

.mood-item.sel .mood-text {
    color: var(--tint);
    font-weight: 600;
}

/* ---------- 时长字段：点一下拉起拉霸 ---------- */
.dur-field {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 18rpx var(--sp-3);
    border-radius: var(--r-md);
    background: var(--fill-1);
    transition: background-color 0.15s ease;
}

.dur-field-hover {
    background: var(--fill-2);
}

.dur-value {
    font-size: var(--t-callout);
    font-weight: 600;
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.dur-tip {
    flex: 1;
    font-size: var(--t-caption);
    color: var(--label-3);
}

.dur-arrow {
    flex: none;
    width: 14rpx;
    height: 14rpx;
    border-right: 3rpx solid var(--label-3);
    border-bottom: 3rpx solid var(--label-3);
    transform: rotate(45deg);
}

/* ---------- 时长拉霸 ---------- */
/* 浮层挂在表单根节点上：page-container 带 transform，fixed 会失效，只能用绝对定位 */
.dur-mask {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 950;
    display: flex;
    align-items: flex-end;
    background: rgba(20, 16, 12, 0.34);
}

.dur-panel {
    width: 100%;
    background: #ffffff;
    border-radius: 28rpx 28rpx 0 0;
    padding-bottom: env(safe-area-inset-bottom);
}

.dur-panel.tabbar-space {
    padding-bottom: calc(env(safe-area-inset-bottom) + 110rpx);
}

.dur-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx var(--sp-4) 6rpx;
}

.dur-cancel {
    font-size: var(--t-callout);
    color: var(--label-2);
    padding: 8rpx 4rpx;
}

.dur-done {
    font-size: var(--t-callout);
    font-weight: 600;
    color: var(--tint);
    padding: 8rpx 4rpx;
}

.dur-title {
    font-size: var(--t-caption);
    color: var(--label-3);
}

.dur-wheel {
    width: 100%;
    height: 380rpx;
}

.dur-item {
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    font-size: var(--t-title3);
    color: var(--label);
    font-variant-numeric: tabular-nums;
}
