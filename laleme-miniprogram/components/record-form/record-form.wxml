<view class="form">
    <!-- 计时区：新建时显示计时器，编辑时只保留时长输入 -->
    <view class="timer-box">
        <view class="t-display" wx:if="{{!isEdit}}">{{timerText}}</view>
        <view class="dur-field" hover-class="dur-field-hover" bindtap="openDuration">
            <text class="dur-value">{{durationLabel}}</text>
            <text class="dur-tip">{{durationTip}}</text>
            <view class="dur-arrow"></view>
        </view>
    </view>

    <!-- 形状：图形选择，一眼对得上 -->
    <view class="sec-label">形状</view>
    <view class="bs-grid">
        <view
            class="bs-item {{item.sel ? 'sel' : ''}} {{item.ideal ? 'ideal' : ''}}"
            wx:for="{{bristolOptions}}"
            wx:key="t"
            data-t="{{item.t}}"
            bindtap="pickBristol"
        >
            <image class="bs-icon" wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit" />
            <view class="bs-unknown" wx:else>?</view>
            <view class="bs-name">{{item.name}}</view>
        </view>
    </view>
    <view class="bs-hint" wx:if="{{bristolHint}}">{{bristolHint}}</view>

    <!-- 颜色 -->
    <view class="sec-label">颜色</view>
    <view class="cl-row">
        <view
            class="cl-item {{item.sel ? 'sel' : ''}}"
            wx:for="{{colorOptions}}"
            wx:key="key"
            data-color="{{item.key}}"
            bindtap="pickColor"
        >
            <view class="cl-dot" style="background: {{item.hex}};"></view>
            <view class="cl-name">{{item.name}}</view>
        </view>
    </view>
    <view class="bs-hint warn" wx:if="{{colorHint}}">{{colorHint}}</view>

    <!-- 感受 -->
    <view class="sec-label">感受</view>
    <view class="mood-row">
        <view
            class="mood-item {{item.sel ? 'sel' : ''}}"
            wx:for="{{moodOptions}}"
            wx:key="key"
            data-mood="{{item.key}}"
            bindtap="pickMood"
        >
            <image class="mood-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="mood-text">{{item.text}}</text>
        </view>
    </view>

    <!-- 时间 -->
    <view class="dt-row">
        <picker mode="date" value="{{dateValue}}" bindchange="onDateChange" class="picker-half">
            <view class="picker-value">{{dateValue}}</view>
        </picker>
        <picker mode="time" value="{{timeValue}}" bindchange="onTimeChange" class="picker-half">
            <view class="picker-value">{{timeValue}}</view>
        </picker>
    </view>

    <button class="primary-btn" hover-class="primary-hover" bindtap="submit">{{isEdit ? '保存修改' : '完成记录'}}</button>
    <view class="danger-link" wx:if="{{isEdit}}" bindtap="removeThis">删除这条记录</view>

<!-- 时长拉霸：默认停在 5 分钟，0 位是「取计时时长」 -->
<view class="dur-mask" wx:if="{{durOpen}}" catchtap="closeDuration" catchtouchmove="stopTouch">
    <view class="dur-panel {{tabbarSpace ? 'tabbar-space' : ''}}" catchtap="stopTouch">
        <view class="dur-head">
            <text class="dur-cancel" bindtap="closeDuration">取消</text>
            <text class="dur-title">本次时长</text>
            <text class="dur-done" bindtap="confirmDuration">完成</text>
        </view>
        <view class="dur-body">
            <picker-view
                class="dur-wheel"
                value="{{durIndex}}"
                indicator-style="height: 88rpx; background: rgba(139, 94, 60, 0.05); border-radius: 20rpx;"
                bindchange="onDurChange"
            >
                <picker-view-column>
                    <view class="dur-item" wx:for="{{durOptions}}" wx:key="value">{{item.label}}</view>
                </picker-view-column>
            </picker-view>
            <view class="dur-fade dur-fade-top"></view>
            <view class="dur-fade dur-fade-bottom"></view>
        </view>
        <view class="dur-gap" wx:if="{{tabbarSpace}}"></view>
        <view class="dur-foot">蹲久了伤膝盖 · 最近的你还好吗</view>
    </view>
</view>
</view>

