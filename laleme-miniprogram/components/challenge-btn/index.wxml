<view class="cb-wrap">
    <button
        class="cb {{badge ? 'is-badge' : ''}}"
        hover-class="cb-hover"
        hover-stay-time="80"
        open-type="share"
        bindtouchstart="onTouch"
    >
        <image class="cb-icon" src="/assets/actions/share-white.png" mode="aspectFit" />
        <text class="cb-text">转发给你在乎的人</text>
    </button>

    <!-- 进度只用一句文字；旁边放一坨金色便便，把奖励说清楚 -->
    <view class="cb-progress {{badge ? 'gold' : ''}}">
        <text class="cb-progress-text">{{badge ? '已解锁黄金大屎官' : '已转发 ' + count + ' 次 · 还差 ' + left + ' 次解锁黄金大屎官'}}</text>
        <text class="cb-progress-poop {{badge ? 'on' : ''}}">💩</text>
    </view>
</view>
