<view class="cb-wrap">
    <button
        class="cb {{badge ? 'is-badge' : ''}}"
        hover-class="cb-hover"
        hover-stay-time="80"
        open-type="share"
        bindtouchstart="onTouch"
    >
        <image class="cb-icon" src="/assets/actions/share-white.png" mode="aspectFit" />
        <text class="cb-text">转发给你在乎的人</text>
    </button>

    <!-- 进度只用一句文字，不再占图形 -->
    <text class="cb-progress {{badge ? 'gold' : ''}}">{{badge ? '已解锁 · 金色传说' : '已转发 ' + count + ' 次 · 还差 ' + left + ' 次'}}</text>
</view>
