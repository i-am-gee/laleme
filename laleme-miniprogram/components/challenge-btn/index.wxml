<view class="cb-wrap">
    <button
        class="cb {{gold ? 'is-badge' : ''}}"
        hover-class="cb-hover"
        hover-stay-time="80"
        open-type="share"
        bindtouchstart="onTouch"
    >
        <image class="cb-icon" src="/assets/actions/share-white.png" mode="aspectFit" />
        <text class="cb-text">转发给你在乎的人</text>
    </button>

    <!-- 进度与身份：解锁后点这行可以在普通 / 金色之间切换 -->
    <view
        class="cb-progress {{gold ? 'gold' : ''}}"
        hover-class="{{badge ? 'cb-progress-hover' : 'none'}}"
        hover-stay-time="80"
        bindtap="onToggle"
    >
        <text class="cb-progress-text">{{progressText}}</text>
        <text class="cb-progress-poop {{gold ? 'on' : ''}}">💩</text>
    </view>
</view>
