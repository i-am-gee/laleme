/* ============================================================
   喊好友挑战 · 与全局大按钮同规格（96rpx / 胶囊 / 实色 tint）
   进度独立成行，按钮本身保持干净
   ============================================================ */

.cb-wrap {
    /* 组件样式隔离，本地兜底一份用到的令牌 */
    --tint: #8b5e3c;
    --tint-strong: #6f4b30;
    --label-3: rgba(60, 58, 55, 0.32);
    --gold: #b8893c;
    --r-full: 999rpx;
    --t-headline: 34rpx;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    width: 100%;
}

.cb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    /* 微信 button 默认宽度 184px，必须显式覆盖 */
    width: 100% !important;
    height: 96rpx;
    margin: 0;
    padding: 0;
    border-radius: var(--r-full);
    background: var(--tint);
    box-shadow: 0 10rpx 24rpx rgba(139, 94, 60, 0.22);
    line-height: 1;
    transition: transform 0.2s var(--ease-spring), background-color 0.12s ease, box-shadow 0.2s ease;
}

.cb::after {
    border: none;
}

.cb-hover {
    background: var(--tint-strong);
    transform: scale(0.985);
    box-shadow: 0 4rpx 12rpx rgba(139, 94, 60, 0.18);
}

.cb-icon {
    width: 30rpx;
    height: 30rpx;
}

.cb-text {
    font-size: var(--t-headline);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 1.5rpx;
}

/* ---------- 进度：三段细条 + 一行说明 ---------- */
.cb-meta {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-top: 14rpx;
    padding: 0 10rpx;
}

.cb-track {
    display: flex;
    gap: 6rpx;
    flex-shrink: 0;
}

.cb-seg {
    width: 60rpx;
    height: 6rpx;
    border-radius: 999rpx;
    background: rgba(120, 104, 88, 0.28);
    transition: background 0.32s ease;
}

.cb-seg.on {
    background: var(--tint);
}

.cb-hint {
    font-size: 22rpx;
    color: rgba(60, 58, 55, 0.48);
    letter-spacing: 0.2rpx;
    line-height: 1.2;
}

.cb-hint.gold {
    color: var(--gold);
    font-weight: 500;
}

/* ---------- 大屎官：整条转金色 + 缓慢扫光 ---------- */
.cb.is-badge {
    overflow: hidden;
    background: linear-gradient(135deg, #b8893c 0%, #e9cb80 46%, #a97c33 100%);
    box-shadow: 0 10rpx 28rpx rgba(170, 125, 50, 0.32);
}

.cb.is-badge::before {
    content: "";
    position: absolute;
    top: -60%;
    bottom: -60%;
    width: 38%;
    left: -60%;
    background: linear-gradient(
        100deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.55) 50%,
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-18deg);
    animation: cbSheen 4.2s ease-in-out 1.6s infinite;
}

@keyframes cbSheen {
    0% {
        left: -60%;
    }
    45%, 100% {
        left: 128%;
    }
}

.cb.is-badge .cb-text {
    color: #3a2a11;
    letter-spacing: 2rpx;
}

.cb.is-badge .cb-icon {
    filter: brightness(0) opacity(0.78);
}

.cb.is-badge + .cb-meta .cb-seg.on {
    background: linear-gradient(90deg, #c9a04e, #efd79a);
}
