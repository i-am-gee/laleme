/* ============================================================
   转发给你在乎的人
   一枚与全局大按钮同规格的胶囊（96rpx / r-full / 实色 tint）
   进度只用一句文字，不占图形
   ============================================================ */

.cb-wrap {
    /* 组件样式隔离，本地兜底一份用到的令牌 */
    --tint: #8b5e3c;
    --tint-strong: #6f4b30;
    --gold: #b8893c;
    --r-full: 999rpx;
    --t-headline: 34rpx;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    width: 100%;
    /* 两种形态高度一致，解锁时不跳版 */
    min-height: 140rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.cb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    /* 微信 button 默认宽度 184px，必须显式覆盖 */
    width: 100% !important;
    height: 96rpx;
    margin: 0;
    padding: 0;
    border-radius: var(--r-full);
    background: var(--tint);
    box-shadow: 0 10rpx 24rpx rgba(139, 94, 60, 0.22);
    line-height: 1;
    transition: transform 0.2s var(--ease-spring), background-color 0.12s ease, box-shadow 0.2s ease;
}

.cb::after {
    border: none;
}

.cb-hover {
    background: var(--tint-strong);
    transform: scale(0.985);
    box-shadow: 0 4rpx 12rpx rgba(139, 94, 60, 0.18);
}

.cb-icon {
    width: 30rpx;
    height: 30rpx;
}

.cb-text {
    font-size: var(--t-headline);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 1.5rpx;
}

/* ---------- 进度：一句话 + 一坨金便便 ---------- */
.cb-progress {
    width: 100%;
    margin-top: 12rpx;
    padding: 0 8rpx;
    box-sizing: border-box;
    /* 用行内流居中，比 flex 更稳：文字和便便作为一个整体对齐 */
    text-align: center;
    line-height: 1.4;
}

.cb-progress-text {
    font-size: 22rpx;
    color: rgba(60, 58, 55, 0.48);
    letter-spacing: 0.2rpx;
}

/* 未解锁时也给一点金色，让「黄金大屎官」这个目标看得见 */
.cb-progress-poop {
    display: inline-block;
    vertical-align: -3rpx;
    margin-left: 8rpx;
    font-size: 26rpx;
    line-height: 1;
    opacity: 0.72;
    filter: sepia(1) saturate(3.4) hue-rotate(-14deg) brightness(1.12);
    transition: opacity 0.3s ease, filter 0.3s ease, transform 0.3s var(--ease-spring);
}

.cb-progress-poop.on {
    opacity: 1;
    filter: sepia(1) saturate(3.6) hue-rotate(-14deg) brightness(1.2)
        drop-shadow(0 0 6rpx rgba(255, 220, 150, 0.85));
    transform: scale(1.1);
}

.cb-progress.gold .cb-progress-text {
    color: var(--gold);
    font-weight: 500;
}

/* ---------- 集齐三次：整枚转金 + 缓慢扫光 ---------- */
.cb.is-badge {
    overflow: hidden;
    background: linear-gradient(135deg, #b8893c 0%, #e9cb80 46%, #a97c33 100%);
    box-shadow: 0 10rpx 28rpx rgba(170, 125, 50, 0.32);
}

.cb.is-badge::before {
    content: "";
    position: absolute;
    top: -60%;
    bottom: -60%;
    width: 38%;
    left: -60%;
    background: linear-gradient(
        100deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.55) 50%,
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-18deg);
    animation: cbSheen 4.2s ease-in-out 1.6s infinite;
}

@keyframes cbSheen {
    0% {
        left: -60%;
    }
    45%, 100% {
        left: 128%;
    }
}

.cb.is-badge .cb-text {
    color: #3a2a11;
    letter-spacing: 2rpx;
}

.cb.is-badge .cb-icon {
    filter: brightness(0) opacity(0.78);
}
