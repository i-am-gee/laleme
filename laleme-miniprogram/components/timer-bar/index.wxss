/* ============================================================
   计时浮条：贴在 tabBar 上方的一张抽屉式卡片
   和记录浮层用同一条 iOS 抓手，暗示「可以往上拉」
   ============================================================ */

.tb {
    /* 组件样式隔离，本地兜底 */
    --r-full: 999rpx;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    position: fixed;
    left: 50%;
    /* 118rpx 的 tabBar + 一点呼吸，再避开安全区 */
    bottom: calc(env(safe-area-inset-bottom) + 128rpx);
    transform: translateX(-50%);
    z-index: 900;

    width: 620rpx;
    box-sizing: border-box;
    padding: 16rpx 40rpx 26rpx;
    border-radius: 40rpx;
    background: rgba(38, 32, 27, 0.95);
    box-shadow: 0 20rpx 52rpx rgba(0, 0, 0, 0.28);

    display: flex;
    flex-direction: column;
    align-items: center;
    animation: tbIn 0.36s var(--ease-spring) both;
    transition: transform 0.16s var(--ease-spring), opacity 0.14s ease;
}

.tb-hover {
    transform: translateX(-50%) scale(0.97);
    opacity: 0.92;
}

/* 与记录浮层一致的抓手条 */
.tb-grabber {
    width: 72rpx;
    height: 10rpx;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.26);
    margin-bottom: 18rpx;
}

.tb-row {
    display: flex;
    align-items: center;
    gap: 14rpx;
}

/* 呼吸的小点：告诉用户它一直活着 */
.tb-pulse {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    background: #f0b95c;
    animation: tbPulse 1.7s ease-in-out infinite;
}

.tb-time {
    font-size: 52rpx;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 1rpx;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
}

.tb-label {
    margin-top: 8rpx;
    font-size: var(--t-caption2);
    color: rgba(255, 255, 255, 0.52);
    letter-spacing: 0.6rpx;
}

@keyframes tbPulse {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.42;
        transform: scale(0.78);
    }
}

@keyframes tbIn {
    0% {
        opacity: 0;
        transform: translateX(-50%) translateY(24rpx) scale(0.92);
    }
    100% {
        opacity: 1;
        transform: translateX(-50%) translateY(0) scale(1);
    }
}
