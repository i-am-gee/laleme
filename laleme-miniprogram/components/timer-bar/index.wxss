/* ============================================================
   计时浮条：贴在 tabBar 上方，深色胶囊，安静但不隐形
   ============================================================ */

.tb {
    /* 组件样式隔离，本地兜底 */
    --r-full: 999rpx;
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    position: fixed;
    left: 50%;
    /* 118rpx 的 tabBar + 一点呼吸，再避开安全区 */
    bottom: calc(env(safe-area-inset-bottom) + 136rpx);
    transform: translateX(-50%);
    z-index: 900;

    display: flex;
    align-items: center;
    gap: 12rpx;
    height: 72rpx;
    padding: 0 28rpx;
    border-radius: var(--r-full);
    background: rgba(43, 36, 30, 0.94);
    box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.26);
    animation: tbIn 0.34s var(--ease-spring) both;
    transition: transform 0.16s var(--ease-spring), opacity 0.14s ease;
}

.tb-hover {
    transform: translateX(-50%) scale(0.96);
    opacity: 0.9;
}

/* 呼吸的小点：告诉用户它一直活着 */
.tb-pulse {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #f0b95c;
    animation: tbPulse 1.7s ease-in-out infinite;
}

.tb-time {
    font-size: var(--t-headline);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.5rpx;
    font-variant-numeric: tabular-nums;
}

.tb-label {
    font-size: var(--t-footnote);
    color: rgba(255, 255, 255, 0.62);
    letter-spacing: 0.5rpx;
}

/* 向上的小箭头，暗示"点我回去" */
.tb-arrow {
    width: 14rpx;
    height: 14rpx;
    margin-left: 2rpx;
    margin-top: 6rpx;
    border-left: 3rpx solid rgba(255, 255, 255, 0.66);
    border-top: 3rpx solid rgba(255, 255, 255, 0.66);
    transform: rotate(45deg);
}

@keyframes tbPulse {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.42;
        transform: scale(0.78);
    }
}

@keyframes tbIn {
    0% {
        opacity: 0;
        transform: translateX(-50%) translateY(16rpx) scale(0.9);
    }
    100% {
        opacity: 1;
        transform: translateX(-50%) translateY(0) scale(1);
    }
}
