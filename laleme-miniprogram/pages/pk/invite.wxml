<view class="page">
    <block wx:if="{{ready && invalid}}">
        <view class="iv-bad">
            <view class="iv-bad-icon">💩</view>
            <view class="iv-bad-t">{{reason}}</view>
            <button class="btn-primary iv-main" hover-class="btn-primary-press" bindtap="goHome">回首页</button>
        </view>
    </block>

    <block wx:elif="{{ready}}">
        <view class="iv-hero">
            <view class="iv-avatar">{{fromInitial}}</view>
            <view class="iv-title">{{fromNick}} 想和你 PK 拉屎</view>
            <view class="iv-sub">同意后，你们会互见下面这三项</view>
        </view>

        <view class="card iv-card">
            <view class="iv-row" wx:for="{{shared}}" wx:key="*this">
                <text class="iv-dot"></text>
                <text class="iv-t">{{item}}</text>
            </view>
        </view>

        <view class="card iv-card iv-card-quiet">
            <view class="iv-q-h">不会共享</view>
            <view class="iv-q-t">每条记录的具体时间、时长与性状，都留在各自手机里。</view>
        </view>

        <button
            class="btn-primary iv-main"
            hover-class="btn-primary-press"
            bindtap="accept"
            disabled="{{submitting}}"
        >{{submitting ? '正在建立…' : '同意，开始 PK'}}</button>
        <view class="iv-later" bindtap="decline">以后再说</view>
    </block>
</view>
