/* ============================================================
   邀请落地页：接收方看到的第一屏
   只做一件事——把「共享什么、不共享什么」说明白，然后给出选择
   ============================================================ */

.iv-hero {
    padding: var(--sp-6) var(--sp-4) var(--sp-5);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.iv-avatar {
    width: 132rpx;
    height: 132rpx;
    border-radius: var(--r-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tint-soft);
    color: var(--tint);
    font-size: 60rpx;
    font-weight: 600;
}

.iv-title {
    margin-top: var(--sp-4);
    font-size: var(--t-title3);
    font-weight: 600;
    color: var(--label);
    text-align: center;
    line-height: 1.35;
}

.iv-sub {
    margin-top: var(--sp-2);
    font-size: var(--t-footnote);
    color: var(--label-2);
}

.iv-card {
    margin-bottom: var(--sp-3);
    padding: var(--sp-4);
}

.iv-row {
    display: flex;
    align-items: center;
    gap: 14rpx;
    padding: 12rpx 0;
}

.iv-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: var(--r-full);
    background: var(--tint-fill);
    flex-shrink: 0;
}

.iv-t {
    font-size: var(--t-body);
    color: var(--label);
}

/* 不共享那块压低一层，避免和「会共享」抢注意力 */
.iv-card-quiet {
    background: var(--fill-1);
}

.iv-q-h {
    font-size: var(--t-footnote);
    font-weight: 600;
    color: var(--label-3);
    margin-bottom: 8rpx;
}

.iv-q-t {
    font-size: var(--t-footnote);
    color: var(--label-2);
    line-height: 1.6;
}

.iv-main {
    width: 100% !important;
    margin: var(--sp-5) 0 0;
    height: 100rpx;
    line-height: 1;
}

.iv-main::after {
    border: none;
}

.iv-later {
    margin-top: var(--sp-4);
    padding: var(--sp-2) 0;
    text-align: center;
    font-size: var(--t-footnote);
    color: var(--label-3);
}

.iv-bad {
    padding: var(--sp-6) var(--sp-4);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.iv-bad-icon {
    font-size: 88rpx;
    line-height: 1;
    opacity: 0.45;
}

.iv-bad-t {
    margin-top: var(--sp-4);
    font-size: var(--t-body);
    color: var(--label-2);
    text-align: center;
    line-height: 1.6;
}
