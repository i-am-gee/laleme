.page {
    padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 130rpx);
}

/* 左滑引导：只有图形，箭头循环向左滑出提示手势 */
.hint {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10rpx 0 14rpx;
    margin-bottom: 4rpx;
    transition: opacity 0.3s;
}

.hint-icon {
    width: 96rpx;
    height: 52rpx;
    animation: swipeHint 1.8s ease-in-out infinite;
}

@keyframes swipeHint {
    0%, 100% { transform: translateX(6rpx); opacity: 0.45; }
    45% { transform: translateX(-10rpx); opacity: 0.95; }
    70% { transform: translateX(6rpx); opacity: 0.45; }
}

.hint.dim {
    opacity: 0.5;
}

.hint-icon {
    font-size: 24rpx;
    color: #b07a4a;
}



.empty {
    text-align: center;
    color: #888780;
    font-size: 27rpx;
    padding: 120rpx 40rpx;
}

.h-date {
    display: flex;
    align-items: baseline;
    gap: 10rpx;
    margin: 26rpx 0 12rpx;
    padding: 2rpx 6rpx;
    border-radius: 12rpx;
}

.h-date-t {
    color: #888780;
    font-size: 24rpx;
    font-weight: 600;
}

.h-date-c {
    color: #b0a394;
    font-size: 21rpx;
}

/* 从首页日历锚定过来的当天高亮 */
.h-date.hl {
    background: #faeeda;
    animation: dateFlash 1.4s ease-out 2;
}

.h-date.hl .h-date-t {
    color: #8b5e3c;
}

@keyframes dateFlash {
    0% { background: #f7e0bd; }
    100% { background: #faeeda; }
}

/* 左滑容器 */
.h-swipe {
    position: relative;
    overflow: hidden;
    border-radius: 24rpx;
    margin-bottom: 14rpx;
    background: transparent;
}

.h-actions {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
}

/* 宽度需与 history.js 的 ACTION_W（68px）保持一致 */
.h-act {
    width: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.act-icon {
    width: 42rpx;
    height: 42rpx;
}

.act-edit {
    background: #a9764f;
}

.act-del {
    background: #d9534f;
}

.h-item {
    position: relative;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 24rpx;
    padding: 22rpx 28rpx;
    transition: transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
}

.h-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
}

.h-time {
    font-size: 30rpx;
    font-weight: 600;
}

.h-arrow {
    font-size: 26rpx;
    color: #c4bcb0;
    letter-spacing: 2rpx;
}

.h-detail {
    font-size: 26rpx;
    color: #888780;
    margin-top: 8rpx;
}
