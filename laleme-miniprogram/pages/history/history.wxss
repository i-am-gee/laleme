/* ============================================================
   历史 · iOS 体例
   ============================================================ */

.page {
    padding: 0 var(--sp-4) calc(env(safe-area-inset-bottom) + 170rpx);
}

/* 左滑引导：内嵌在首条记录卡右侧，随首次左滑消失 */
.h-peek {
    width: 64rpx;
    height: 40rpx;
    flex-shrink: 0;
    opacity: 0.55;
    animation: peekNudge 1.8s var(--ease-sheet) infinite;
}

@keyframes peekNudge {
    0%, 100% {
        transform: translateX(6rpx);
        opacity: 0.35;
    }
    45% {
        transform: translateX(-8rpx);
        opacity: 0.75;
    }
    70% {
        transform: translateX(6rpx);
        opacity: 0.35;
    }
}

.empty {
    text-align: center;
    color: var(--label-3);
    font-size: var(--t-subhead);
    padding: 140rpx var(--sp-5);
    line-height: 1.7;
}

/* ---------- 日期分组标题 ---------- */
.h-date {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    margin: var(--sp-4) var(--sp-1) var(--sp-2);
    padding: 2rpx var(--sp-1);
    border-radius: 12rpx;
}

.h-date-t {
    color: var(--label-2);
    font-size: var(--t-footnote);
    font-weight: 600;
    letter-spacing: 0.3rpx;
}

.h-date-c {
    color: var(--label-3);
    font-size: var(--t-caption);
    font-variant-numeric: tabular-nums;
}

/* 逐条飞入：日期标题随后面的卡片一起淡入上浮 */
.h-date {
    animation: dateIn 0.34s var(--ease-sheet) backwards;
}

@keyframes dateIn {
    0% {
        opacity: 0;
        transform: translateY(12rpx);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 从首页日历锚定过来的当天高亮 */
.h-date.hl {
    background: var(--tint-soft);
    animation: dateIn 0.34s var(--ease-sheet) backwards, dateFlash 1.4s var(--ease-sheet) 2;
}

.h-date.hl .h-date-t {
    color: var(--tint);
}

.h-date.hl .h-date-c {
    color: var(--tint);
    opacity: 0.7;
}

@keyframes dateFlash {
    0% {
        background: var(--tint-fill);
    }
    100% {
        background: var(--tint-soft);
    }
}

/* ---------- 左滑容器 ---------- */
.h-swipe {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    margin-bottom: var(--sp-2);
    background: transparent;
    /* 从左侧带一点下沉与缩放飞入，落定后完全静止（不干扰侧滑的 transform） */
    animation: swipeFlyIn 0.46s cubic-bezier(0.22, 0.9, 0.25, 1) backwards;
}

@keyframes swipeFlyIn {
    0% {
        opacity: 0;
        transform: translateX(-52rpx) translateY(22rpx) scale(0.94);
    }
    100% {
        opacity: 1;
        transform: translateX(0) translateY(0) scale(1);
    }
}

.h-actions {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    /* 与卡片同圆角，避免操作区方角在卡片圆角处露出暖色 */
    border-radius: var(--r-md);
    overflow: hidden;
}

/* 宽度需与 history.js 的 ACTION_W（68px）保持一致 */
.h-act {
    width: 68px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rpx;
}

/* 侧滑操作：图标在上、文字在下，比纯图标更好认，也更接近 iOS 列表的操作样式 */
.act-icon {
    width: 46rpx;
    height: 46rpx;
    opacity: 0.96;
}

.act-label {
    margin-top: 8rpx;
    font-size: 20rpx;
    line-height: 1;
    letter-spacing: 1rpx;
    color: rgba(255, 255, 255, 0.92);
}

/* iOS 侧滑动作：中性灰 + 系统红，图标一律白 */
.act-edit {
    background: #8e8e93;
}

.act-del {
    background: var(--red);
}

/* ---------- 记录卡片 ---------- */
.h-item {
    position: relative;
    background: var(--bg-card);
    border: none;
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-4);
    transition: transform 0.26s var(--ease-sheet);
    will-change: transform;
}

.h-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
}

.h-shape {
    flex: none;
    width: 72rpx;
    height: 72rpx;
}

.h-shape-none {
    line-height: 72rpx;
    text-align: center;
    font-size: var(--t-subhead);
    color: var(--label-4);
    background: var(--fill-1);
    border-radius: var(--r-full);
}

.h-body {
    flex: 1;
    min-width: 0;
}

.h-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2);
}

.h-dur {
    font-size: var(--t-footnote);
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
}

/* 第二行：颜色圆点 + 感受小脸，一行看完这一次长什么样 */
.h-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: 6rpx;
}

.h-chip {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.h-dot {
    width: 22rpx;
    height: 22rpx;
    border-radius: var(--r-full);
    box-shadow: inset 0 0 0 1rpx rgba(60, 40, 20, 0.14);
}

.h-mood {
    width: 32rpx;
    height: 32rpx;
}

.h-chip-t {
    font-size: var(--t-caption);
    color: var(--label-3);
    line-height: 1.2;
}

.h-time {
    font-size: var(--t-body);
    font-weight: 600;
    color: var(--label);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.2rpx;
}

.h-arrow {
    font-size: var(--t-subhead);
    color: var(--label-4);
    letter-spacing: 2rpx;
}

.h-detail {
    font-size: var(--t-footnote);
    color: var(--label-2);
    margin-top: 6rpx;
    line-height: 1.45;
}
