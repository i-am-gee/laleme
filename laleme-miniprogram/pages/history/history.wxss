/* ============================================================
   历史 · iOS 体例
   ============================================================ */

.page {
    padding: 0 var(--sp-4) calc(env(safe-area-inset-bottom) + 130rpx);
}

/* 左滑引导：只有图形，箭头循环向左滑出提示手势 */
.hint {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-2) 0 var(--sp-3);
    transition: opacity 0.3s ease;
}

.hint-icon {
    width: 96rpx;
    height: 52rpx;
    animation: swipeHint 2.4s var(--ease-sheet) infinite;
}

@keyframes swipeHint {
    0%, 100% {
        transform: translateX(6rpx);
        opacity: 0.35;
    }
    45% {
        transform: translateX(-10rpx);
        opacity: 0.9;
    }
    70% {
        transform: translateX(6rpx);
        opacity: 0.35;
    }
}

.hint.dim {
    opacity: 0.45;
}

.empty {
    text-align: center;
    color: var(--label-3);
    font-size: var(--t-subhead);
    padding: 140rpx var(--sp-5);
    line-height: 1.7;
}

/* ---------- 日期分组标题 ---------- */
.h-date {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    margin: var(--sp-4) var(--sp-1) var(--sp-2);
    padding: 2rpx var(--sp-1);
    border-radius: 12rpx;
}

.h-date-t {
    color: var(--label-2);
    font-size: var(--t-footnote);
    font-weight: 600;
    letter-spacing: 0.3rpx;
}

.h-date-c {
    color: var(--label-3);
    font-size: var(--t-caption);
    font-variant-numeric: tabular-nums;
}

/* 从首页日历锚定过来的当天高亮 */
.h-date.hl {
    background: var(--tint-soft);
    animation: dateFlash 1.4s var(--ease-sheet) 2;
}

.h-date.hl .h-date-t {
    color: var(--tint);
}

.h-date.hl .h-date-c {
    color: var(--tint);
    opacity: 0.7;
}

@keyframes dateFlash {
    0% {
        background: var(--tint-fill);
    }
    100% {
        background: var(--tint-soft);
    }
}

/* ---------- 左滑容器 ---------- */
.h-swipe {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    margin-bottom: var(--sp-2);
    background: transparent;
}

.h-actions {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    /* 与卡片同圆角，避免操作区方角在卡片圆角处露出暖色 */
    border-radius: var(--r-md);
    overflow: hidden;
}

/* 宽度需与 history.js 的 ACTION_W（68px）保持一致 */
.h-act {
    width: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.act-icon {
    width: 42rpx;
    height: 42rpx;
}

/* iOS 侧滑动作：中性灰 + 系统红，图标一律白 */
.act-edit {
    background: #8e8e93;
}

.act-del {
    background: var(--red);
}

/* ---------- 记录卡片 ---------- */
.h-item {
    position: relative;
    background: var(--bg-card);
    border: none;
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-4);
    transition: transform 0.26s var(--ease-sheet);
    will-change: transform;
}

.h-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2);
}

.h-time {
    font-size: var(--t-body);
    font-weight: 600;
    color: var(--label);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.2rpx;
}

.h-arrow {
    font-size: var(--t-subhead);
    color: var(--label-4);
    letter-spacing: 2rpx;
}

.h-detail {
    font-size: var(--t-footnote);
    color: var(--label-2);
    margin-top: 6rpx;
    line-height: 1.45;
}
