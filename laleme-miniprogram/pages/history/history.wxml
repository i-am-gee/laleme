<view class="page">
    <!-- iOS Large Title -->
    <view class="nav-bar" style="padding-top: {{navTop}}px;">
        <view class="nav-title">历史</view>
    </view>

    <!-- 左滑引导不再单独占一条，移到首条记录卡内 -->

    <block wx:if="{{empty}}">
        <view class="empty">还没有记录，去首页「记一次」开始吧</view>
    </block>
    <block wx:else>
        <block wx:for="{{groups}}" wx:key="key" wx:for-item="group" wx:for-index="gi">
            <view class="h-date {{highlightKey === group.key ? 'hl' : ''}}" id="d-{{group.key}}">
                <text class="h-date-t">{{group.day}}</text>
                <text class="h-date-c">{{group.count}} 次</text>
            </view>
            <view class="h-swipe" wx:for="{{group.items}}" wx:key="id" wx:for-item="item" wx:for-index="ii">
                <view class="h-actions">
                    <view class="h-act act-edit" data-g="{{gi}}" data-i="{{ii}}" bindtap="onEdit">
                        <image class="act-icon" src="/assets/actions/edit.png" mode="aspectFit" />
                    </view>
                    <view class="h-act act-del" data-g="{{gi}}" data-i="{{ii}}" bindtap="onDelete">
                        <image class="act-icon" src="/assets/actions/trash.png" mode="aspectFit" />
                    </view>
                </view>
                <view
                    class="h-item"
                    style="transform: translateX({{item.x}}px);"
                    data-g="{{gi}}"
                    data-i="{{ii}}"
                    bindtouchstart="onTouchStart"
                    bindtouchmove="onTouchMove"
                    bindtouchend="onTouchEnd"
                    bindtouchcancel="onTouchEnd"
                    bindtap="onItemTap"
                >
                    <view class="h-top">
                        <text class="h-time">{{item.time}}</text>
                        <image
                            wx:if="{{gi === 0 && ii === 0 && !hintDim}}"
                            class="h-peek"
                            src="/assets/actions/swipe.png"
                            mode="aspectFit"
                        />
                        <text wx:else class="h-arrow">⋯</text>
                    </view>
                    <view class="h-detail">{{item.detail}}</view>
                </view>
            </view>
        </block>
    </block>
</view>
