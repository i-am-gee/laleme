<view class="page">
    <!-- iOS Large Title -->
    <view class="nav-bar" style="padding-top: {{navTop}}px;">
        <view class="nav-title">历史</view>
    </view>

    <!-- 左滑引导不再单独占一条，移到首条记录卡内 -->

    <block wx:if="{{empty}}">
        <view class="empty">还没有记录，去首页「记一次」开始吧</view>
    </block>
    <block wx:else>
        <block wx:for="{{groups}}" wx:key="animKey" wx:for-item="group" wx:for-index="gi">
            <view
                class="h-date {{highlightKey === group.key ? 'hl' : ''}}"
                id="d-{{group.key}}"
                style="animation-delay: {{group.delay}}ms;"
            >
                <text class="h-date-t">{{group.day}}</text>
                <text class="h-date-c">{{group.count}} 次</text>
            </view>
            <view
                class="h-swipe"
                wx:for="{{group.items}}"
                wx:key="animKey"
                wx:for-item="item"
                wx:for-index="ii"
                style="animation-delay: {{item.delay}}ms;"
            >
                <view class="h-actions">
                    <view class="h-act act-edit" data-g="{{gi}}" data-i="{{ii}}" bindtap="onEdit">
                        <image class="act-icon" src="/assets/actions/edit.png" mode="aspectFit" />
                        <text class="act-label">编辑</text>
                    </view>
                    <view class="h-act act-del" data-g="{{gi}}" data-i="{{ii}}" bindtap="onDelete">
                        <image class="act-icon" src="/assets/actions/trash.png" mode="aspectFit" />
                        <text class="act-label">删除</text>
                    </view>
                </view>
                <view
                    class="h-item"
                    style="transform: translateX({{item.x}}px);"
                    data-g="{{gi}}"
                    data-i="{{ii}}"
                    bindtouchstart="onTouchStart"
                    bindtouchmove="onTouchMove"
                    bindtouchend="onTouchEnd"
                    bindtouchcancel="onTouchEnd"
                    bindtap="onItemTap"
                >
                    <view class="h-row">
                        <!-- 形状用图标直接说话，颜色用圆点，感受用小表情 -->
                        <image class="h-shape" wx:if="{{item.shapeIcon}}" src="{{item.shapeIcon}}" mode="aspectFit" />
                        <view class="h-shape h-shape-none" wx:else>?</view>
                        <view class="h-body">
                            <view class="h-top">
                                <text class="h-time">{{item.time}}</text>
                                <text class="h-dur">{{item.durText}}</text>
                            </view>
                            <view class="h-meta">
                                <view class="h-chip" wx:if="{{item.colorHex}}">
                                    <view class="h-dot" style="background: {{item.colorHex}};"></view>
                                    <text class="h-chip-t">{{item.colorName}}</text>
                                </view>
                                <view class="h-chip" wx:if="{{item.moodIcon}}">
                                    <image class="h-mood" src="{{item.moodIcon}}" mode="aspectFit" />
                                    <text class="h-chip-t">{{item.moodText}}</text>
                                </view>
                            </view>
                        </view>
                        <image
                            wx:if="{{gi === 0 && ii === 0 && !hintDim}}"
                            class="h-peek"
                            src="/assets/actions/swipe.png"
                            mode="aspectFit"
                        />
                        <text wx:else class="h-arrow">⋯</text>
                    </view>
                </view>
            </view>
        </block>
    </block>
</view>

<!-- 计时浮条：任意页都能看到还在计时 -->
<timer-bar />
