/* ============================================================
   数据备份与恢复 · iOS 体例
   ============================================================ */

.page {
    padding: var(--sp-3) var(--sp-4) var(--sp-6);
}

.summary {
    text-align: center;
    padding: var(--sp-3) 0 var(--sp-4);
}

.sum-num {
    font-size: var(--t-large);
    font-weight: 700;
    color: var(--label);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -1rpx;
}

.sum-lbl {
    font-size: var(--t-footnote);
    color: var(--label-2);
    margin-top: 6rpx;
}

/* 分组标题：iOS Grouped Header */
.sec-title {
    font-size: var(--t-footnote);
    color: var(--label-2);
    font-weight: 400;
    margin: var(--sp-4) var(--sp-2) var(--sp-1);
    letter-spacing: 0.4rpx;
}

.sec-card {
    background: var(--bg-card);
    border-radius: var(--r-lg);
    overflow: hidden;
}

.row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 88rpx;
    padding: var(--sp-2) var(--sp-4);
    position: relative;
    box-sizing: border-box;
    transition: background-color 0.12s ease;
}

.row + .row::before {
    content: "";
    position: absolute;
    left: var(--sp-4);
    right: 0;
    top: 0;
    height: 0.5rpx;
    background: var(--sep);
    transform: scaleY(0.5);
}

.row:active {
    background: var(--fill-1);
}

.row-main {
    flex: 1;
    min-width: 0;
    padding: var(--sp-2) 0;
}

.row-title {
    font-size: var(--t-body);
    font-weight: 400;
    color: var(--label);
    line-height: 1.4;
}

.row-sub {
    font-size: var(--t-footnote);
    color: var(--label-2);
    margin-top: 4rpx;
    line-height: 1.45;
}

.row-arrow {
    font-size: var(--t-subhead);
    color: var(--label-4);
    margin-left: var(--sp-2);
}

/* ---------- 手动粘贴：默认折叠 ---------- */
.collapse {
    margin-top: var(--sp-3);
    background: var(--bg-card);
    border-radius: var(--r-lg);
    overflow: hidden;
}

.collapse-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 88rpx;
    padding: var(--sp-2) var(--sp-4);
    box-sizing: border-box;
}

.row-press {
    background: var(--fill-1);
}

.collapse-title {
    font-size: var(--t-body);
    color: var(--label);
}

/* 折叠箭头：收起朝下，展开朝上 */
.collapse-arrow {
    width: 14rpx;
    height: 14rpx;
    border-right: 3rpx solid var(--label-3);
    border-bottom: 3rpx solid var(--label-3);
    transform: rotate(45deg);
    transition: transform 0.24s var(--ease-sheet);
    margin-top: -6rpx;
}

.collapse-arrow.open {
    transform: rotate(-135deg);
    margin-top: 6rpx;
}

.collapse-body {
    padding: 0 var(--sp-4) var(--sp-4);
    animation: collapseIn 0.24s var(--ease-sheet);
}

@keyframes collapseIn {
    0% {
        opacity: 0;
        transform: translateY(-8rpx);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

.paste-box {
    width: 100%;
    box-sizing: border-box;
    min-height: 180rpx;
    max-height: 360rpx;
    background: var(--fill-1);
    border-radius: var(--r-sm);
    padding: var(--sp-2) var(--sp-3);
    font-size: var(--t-caption);
    color: var(--label);
    line-height: 1.6;
}

.paste-ph {
    color: var(--label-3);
    font-size: var(--t-caption);
}

.paste-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--sp-3);
    height: 96rpx;
    border-radius: var(--r-full);
    background: var(--tint);
    color: #ffffff;
    font-size: var(--t-callout);
    font-weight: 600;
    letter-spacing: 0.5rpx;
    box-shadow: 0 8rpx 22rpx rgba(139, 94, 60, 0.20);
    transition: transform 0.2s var(--ease-spring), opacity 0.12s ease;
}

.btn-hover {
    transform: scale(0.98);
    opacity: 0.9;
}

/* ---------- 结果条 ---------- */
.status {
    margin-top: var(--sp-3);
    border-radius: var(--r-sm);
    padding: var(--sp-2) var(--sp-3);
    font-size: var(--t-footnote);
    line-height: 1.6;
}

.status.info {
    background: var(--fill-1);
    color: var(--label-2);
}

.status.ok {
    background: rgba(52, 199, 89, 0.12);
    color: #1f7a45;
}

.status.warn {
    background: rgba(255, 59, 48, 0.10);
    color: #b3261e;
}

.tip {
    margin-top: var(--sp-4);
    font-size: var(--t-caption);
    color: var(--label-3);
    line-height: 1.7;
    padding: 0 var(--sp-1);
}

.danger-link {
    margin-top: var(--sp-5);
    text-align: center;
    font-size: var(--t-subhead);
    color: var(--red);
    padding: var(--sp-2) 0;
}

/* ============================================================
   导入结果弹窗：iOS Alert 体例
   ============================================================ */
.res-mask {
    position: fixed;
    inset: 0;
    background: rgba(18, 16, 14, 0.42);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-6) var(--sp-5);
}

.res-card {
    width: 100%;
    max-width: 560rpx;
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-5) var(--sp-4) var(--sp-4);
    box-sizing: border-box;
    text-align: center;
    animation: resIn 0.28s var(--ease-spring);
}

@keyframes resIn {
    0% {
        transform: scale(0.92);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.res-badge {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    margin: 0 auto var(--sp-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 52rpx;
    font-weight: 600;
    color: #ffffff;
}

.res-badge.ok {
    background: #34c759;
}

.res-badge.warn {
    background: var(--orange);
}

.res-title {
    font-size: var(--t-title3);
    font-weight: 600;
    color: var(--label);
    letter-spacing: -0.3rpx;
    margin-bottom: var(--sp-3);
}

.res-body {
    background: var(--fill-1);
    border-radius: var(--r-md);
    padding: var(--sp-1) var(--sp-3);
    margin-bottom: var(--sp-3);
}

.res-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 64rpx;
    font-size: var(--t-footnote);
}

.res-k {
    color: var(--label-2);
}

.res-v {
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.res-v.strong {
    font-weight: 600;
    color: var(--tint);
}

.res-note {
    font-size: var(--t-caption);
    color: var(--label-3);
    line-height: 1.55;
    margin-bottom: var(--sp-3);
    text-align: left;
}

.res-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 92rpx;
    border-radius: var(--r-full);
    background: var(--tint);
    color: #ffffff;
    font-size: var(--t-body);
    font-weight: 600;
}
