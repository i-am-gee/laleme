<view class="page">
    <view class="summary">
        <view class="sum-num">{{total}}</view>
        <view class="sum-lbl">条记录保存在本机</view>
    </view>

    <!-- 导出 -->
    <view class="sec-title">备份</view>
    <view class="sec-card">
        <view class="row" bindtap="exportFile">
            <view class="row-main">
                <view class="row-title">导出为文件</view>
                <view class="row-sub">生成 .csv 文件，可直接发给文件传输助手</view>
            </view>
            <view class="row-arrow">›</view>
        </view>
        <view class="row" bindtap="copyCsv">
            <view class="row-main">
                <view class="row-title">复制 CSV 到剪贴板</view>
                <view class="row-sub">粘到文件传输助手、备忘录或邮件，在电脑上另存</view>
            </view>
            <view class="row-arrow">›</view>
        </view>
    </view>

    <!-- 恢复 -->
    <view class="sec-title">恢复</view>
    <view class="sec-card">
        <view class="row" bindtap="importClipboard">
            <view class="row-main">
                <view class="row-title">从剪贴板导入</view>
                <view class="row-sub">先在电脑或备忘录里复制 CSV 内容，再回到这里</view>
            </view>
            <view class="row-arrow">›</view>
        </view>
    </view>

    <!-- 手动粘贴：默认折叠，避免与剪贴板导入重复 -->
    <view class="collapse">
        <view class="collapse-head" bindtap="togglePaste" hover-class="row-press">
            <text class="collapse-title">手动粘贴导入</text>
            <view class="collapse-arrow {{pasteOpen ? 'open' : ''}}"></view>
        </view>
        <view class="collapse-body" wx:if="{{pasteOpen}}">
            <textarea
                class="paste-box"
                placeholder="把 CSV 内容粘贴到这里，首行：时间,时长(分钟),布里斯托类型,感觉"
                placeholder-class="paste-ph"
                value="{{pasteText}}"
                bindinput="onPasteInput"
                maxlength="-1"
                auto-height
                show-confirm-bar="{{false}}"
            ></textarea>
            <view class="paste-btn" hover-class="btn-hover" bindtap="importPasted">导入粘贴的内容</view>
        </view>
    </view>

    <!-- 失败/提示反馈；成功结果走独立弹窗 -->
    <view class="status {{statusType}}" wx:if="{{status}}">{{status}}</view>

    <view class="tip">
        导入按「时间 + 时长」去重，重复的记录不会重复写入。备份文件同时包含分享进度与「大屎官」称号，导入即可整体恢复。数据全部只在本机，不会上传。
    </view>

    <view class="danger-link" bindtap="clearAll">清空全部数据</view>
</view>

<!-- 导入结果确认弹窗 -->
<view class="res-mask" wx:if="{{resultShow}}" catchtouchmove="noop">
    <view class="res-card">
        <view class="res-badge {{resultAdded > 0 ? 'ok' : 'warn'}}">{{resultAdded > 0 ? '✓' : '!'}}</view>
        <view class="res-title">{{resultAdded > 0 ? '导入完成' : '没有新增记录'}}</view>
        <view class="res-body">
            <view class="res-row">
                <text class="res-k">识别到</text>
                <text class="res-v">{{resultTotal}} 条</text>
            </view>
            <view class="res-row">
                <text class="res-k">新增</text>
                <text class="res-v strong">{{resultAdded}} 条</text>
            </view>
            <view class="res-row" wx:if="{{resultSkipped > 0}}">
                <text class="res-k">跳过</text>
                <text class="res-v">{{resultSkipped}} 条</text>
            </view>
        </view>
        <view class="res-note" wx:if="{{resultShare}}">{{resultShare}}</view>
        <view class="res-note" wx:if="{{resultSkipped > 0}}">跳过的是与现有记录重复、或格式不完整的数据</view>
        <view class="res-btn" hover-class="btn-hover" bindtap="closeResult">知道了</view>
    </view>
</view>
