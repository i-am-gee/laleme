.page {
    padding: 24rpx 32rpx 80rpx;
}

.timer-box {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
    padding: 36rpx;
    text-align: center;
    margin-bottom: 28rpx;
}

.t-display {
    font-size: 72rpx;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
}

.t-state {
    font-size: 25rpx;
    color: #888780;
    margin-top: 6rpx;
}

.manual-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14rpx;
    margin-top: 22rpx;
}

.manual-input {
    width: 130rpx;
    padding: 12rpx;
    border: 1rpx solid rgba(44, 44, 42, 0.15);
    border-radius: 14rpx;
    font-size: 28rpx;
    text-align: center;
}

.manual-tip {
    font-size: 23rpx;
    color: #888780;
}

.q-label {
    font-size: 28rpx;
    font-weight: 600;
    margin: 28rpx 0 16rpx;
}

.dt-row {
    display: flex;
    gap: 16rpx;
}

.picker-half {
    flex: 1;
}

.picker-value {
    background: #ffffff;
    border: 1rpx solid rgba(44, 44, 42, 0.15);
    border-radius: 16rpx;
    padding: 20rpx;
    font-size: 28rpx;
    text-align: center;
}

.bs-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.bs-item {
    width: 158rpx;
    background: #ffffff;
    border: 3rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 16rpx;
    padding: 14rpx 0;
    text-align: center;
}

.bs-item.ideal {
    border-color: rgba(15, 110, 86, 0.5);
}

.bs-item.sel {
    border-color: #8b5e3c;
    background: #faeeda;
}

.bs-item.ideal.sel {
    border-color: #0f6e56;
    background: #e1f5ee;
}

.bs-num {
    font-size: 30rpx;
    font-weight: 700;
    color: #8b5e3c;
}

.bs-name {
    font-size: 23rpx;
    margin-top: 4rpx;
}

.bs-hint {
    font-size: 23rpx;
    color: #888780;
    margin-top: 14rpx;
    min-height: 32rpx;
}

.mood-row {
    display: flex;
    gap: 14rpx;
}

.mood-item {
    flex: 1;
    background: #ffffff;
    border: 3rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 16rpx;
    padding: 20rpx 0;
    text-align: center;
    font-size: 27rpx;
}

.mood-item.sel {
    border-color: #8b5e3c;
    background: #faeeda;
    color: #8b5e3c;
    font-weight: 600;
}

.primary-btn {
    background: #8b5e3c;
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 600;
    margin-top: 40rpx;
}

.danger-btn {
    background: #e24b4a;
    color: #ffffff;
    font-size: 30rpx;
    margin-top: 20rpx;
}
