<view class="page">
    <!-- iOS Large Title -->
    <view class="nav-bar" style="padding-top: {{navTop}}px;">
        <view class="nav-title">我的</view>
        <view class="nav-sub">数据只留在本机</view>
    </view>

    <view class="card">
        <view class="info-row">
            <text class="label">已记录条数</text>
            <text class="value">{{countText}}</text>
        </view>
        <view class="info-row">
            <text class="label">最早记录</text>
            <text class="value">{{firstText}}</text>
        </view>
        <view class="info-row">
            <text class="label">连续记录</text>
            <text class="value">{{streakText}}</text>
        </view>
        <view class="info-row">
            <text class="label">存储方式</text>
            <text class="value">本机本地存储</text>
        </view>
        <view class="info-row link-row" bindtap="goPrivacy">
            <text class="label">用户隐私保护指引</text>
            <view class="chevron"></view>
        </view>
    </view>

    <button class="primary-btn" hover-class="primary-hover" open-type="share" bindtouchstart="onShareTouch">分享给朋友</button>
    <button class="ghost-btn" hover-class="ghost-hover" bindtap="goDataPage" bindtouchstart="onShareTouch">数据备份与恢复</button>

    <view class="card about">
        <view class="about-text">「拉了么」v1.7.1 · 数据仅保存在本机，不上传任何服务器。\n\n性状分类采用国际通用的布里斯托大便分类法（Bristol Stool Scale）。\n\n本应用不构成医疗建议，持续异常请咨询消化科医生。</view>
    </view>
</view>

<!-- 分享海报绘制画布（不可见） -->
<canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
