<view class="page">
    <view class="card">
        <view class="info-row">
            <text class="label">已记录条数</text>
            <text class="value">{{countText}}</text>
        </view>
        <view class="info-row">
            <text class="label">最早记录</text>
            <text class="value">{{firstText}}</text>
        </view>
        <view class="info-row">
            <text class="label">存储方式</text>
            <text class="value">本机本地存储</text>
        </view>
        <view class="info-row">
            <text class="label">连续记录</text>
            <text class="value">{{streakText}}</text>
        </view>
        <view class="info-row link-row" bindtap="goPrivacy">
            <text class="label">用户隐私保护指引</text>
            <text class="value">></text>
        </view>
    </view>

    <!-- 每日提醒 -->
    <view class="card">
        <view class="section-head">⏰ 每日提醒</view>
        <view class="info-row">
            <text class="label">到点提醒打卡</text>
            <switch checked="{{reminderOn}}" color="#8B5E3C" bindchange="onReminderToggle" />
        </view>
        <view class="info-row" wx:if="{{reminderOn}}">
            <text class="label">提醒时间</text>
            <picker mode="time" value="{{reminderTime}}" bindchange="onReminderTime">
                <view class="value time-value">{{reminderTime}} ▾</view>
            </picker>
        </view>
        <view class="reminder-tip">到点后打开小程序，首页会置顶提醒你完成今日打卡。</view>
        <button class="ghost-btn slim" bindtap="subscribeReminder">订阅提醒消息</button>
    </view>

    <button class="ghost-btn" open-type="share">💩 分享给朋友</button>
    <button class="ghost-btn" bindtap="exportFile">📤 导出数据文件</button>
    <button class="ghost-btn" bindtap="importFile">📥 从文件导入</button>
    <button class="ghost-btn" bindtap="exportCSV">导出 CSV 到剪贴板</button>
    <button class="danger-btn" bindtap="clearAll">清空全部数据</button>

    <view class="card about">
        <view class="about-text">「拉了么」v1.3 · 数据仅保存在本机，不上传任何服务器。\n\n性状分类采用国际通用的布里斯托大便分类法（Bristol Stool Scale）。\n\n本应用不构成医疗建议，持续异常请咨询消化科医生。</view>
    </view>
</view>

<!-- 分享海报绘制画布（不可见） -->
<canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
