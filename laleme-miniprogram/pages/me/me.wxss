.page {
    padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 120rpx);
}

.card {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
    padding: 10rpx 30rpx;
    margin-bottom: 28rpx;
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26rpx 0;
    border-bottom: 0.5rpx solid rgba(44, 44, 42, 0.08);
}

.info-row:last-child {
    border-bottom: none;
}

.label {
    color: #888780;
    font-size: 27rpx;
}

.value {
    color: #2c2c2a;
    font-size: 27rpx;
    font-weight: 500;
}

/* 主按钮：与首页「记一次」同视觉 */
.primary-btn {
    background: linear-gradient(135deg, #a97750 0%, #8b5e3c 55%, #6f4b30 100%);
    color: #ffffff;
    font-size: 36rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
    border-radius: 52rpx;
    width: 100% !important;
    box-sizing: border-box;
    height: 104rpx;
    line-height: 104rpx;
    padding: 0;
    margin: 8rpx 0 24rpx;
    box-shadow: 0 12rpx 28rpx rgba(139, 94, 60, 0.3);
}

.primary-btn::after {
    border: none;
}

/* 次级按钮 */
.ghost-btn {
    background: #ffffff;
    color: #8b5e3c;
    border: 1rpx solid #8b5e3c;
    font-size: 30rpx;
    font-weight: 500;
    height: 96rpx;
    line-height: 96rpx;
    padding: 0;
    width: 100% !important;
    box-sizing: border-box;
    border-radius: 48rpx;
    margin-bottom: 24rpx;
}

.ghost-btn::after {
    border: none;
}

/* 清空：降级为小号文字链接，弱化危险操作 */
.danger-link {
    text-align: center;
    font-size: 26rpx;
    color: #c0766f;
    padding: 8rpx 0 32rpx;
}

.about {
    padding: 26rpx 30rpx;
}

.about-text {
    font-size: 25rpx;
    color: #888780;
    line-height: 1.7;
    white-space: pre-line;
}

/* 隐藏分享画布 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}
