/* ============================================================
   我的 · iOS 设置页体例
   ============================================================ */

.page {
    padding: 0 var(--sp-4) calc(env(safe-area-inset-bottom) + 130rpx);
}

/* 列表容器：无描边，行内缩分隔线 */
.card {
    background: var(--bg-card);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin-bottom: var(--sp-3);
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    min-height: 88rpx;
    padding: var(--sp-2) var(--sp-4);
    position: relative;
    box-sizing: border-box;
    transition: background-color 0.12s ease;
}

.info-row + .info-row::before {
    content: "";
    position: absolute;
    left: var(--sp-4);
    right: 0;
    top: 0;
    height: 0.5rpx;
    background: var(--sep);
    transform: scaleY(0.5);
}

.info-row:active {
    background: var(--fill-1);
}

.label {
    color: var(--label);
    font-size: var(--t-body);
    flex-shrink: 0;
}

.value {
    color: var(--label-2);
    font-size: var(--t-body);
    text-align: right;
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.link-row .value {
    display: flex;
    align-items: center;
}

/* 主按钮：实心胶囊，与首页同一套语言 */
.primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100% !important;
    height: 100rpx;
    margin: 0 0 var(--sp-2);
    padding: 0;
    border: none;
    border-radius: var(--r-full);
    background: var(--tint);
    color: #ffffff;
    font-size: var(--t-body);
    font-weight: 600;
    letter-spacing: 0.5rpx;
    box-shadow: 0 10rpx 28rpx rgba(139, 94, 60, 0.22);
    transition: transform 0.2s var(--ease-spring), opacity 0.12s ease;
    box-sizing: border-box;
}

.primary-btn::after {
    border: none;
}

.primary-hover {
    transform: scale(0.97);
    opacity: 0.9;
}

/* 次级按钮：淡填充 */
.ghost-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100% !important;
    height: 96rpx;
    margin: 0 0 var(--sp-2);
    padding: 0;
    border: none;
    border-radius: var(--r-full);
    background: var(--tint-soft);
    color: var(--tint);
    font-size: var(--t-body);
    font-weight: 500;
    transition: transform 0.2s var(--ease-spring), background-color 0.12s ease;
    box-sizing: border-box;
}

.ghost-btn::after {
    border: none;
}

.ghost-hover {
    background: var(--tint-fill);
    transform: scale(0.98);
}

.about {
    padding: var(--sp-4);
    margin-top: var(--sp-3);
}

.about-text {
    font-size: var(--t-footnote);
    color: var(--label-2);
    line-height: 1.72;
    white-space: pre-line;
}

/* 隐藏分享画布 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}
