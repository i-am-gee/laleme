.page {
    padding: 24rpx 32rpx 60rpx;
}

.card {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
    padding: 10rpx 30rpx;
    margin-bottom: 28rpx;
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26rpx 0;
    border-bottom: 0.5rpx solid rgba(44, 44, 42, 0.08);
}

.info-row:last-child {
    border-bottom: none;
}

.label {
    color: #888780;
    font-size: 27rpx;
}

.value {
    color: #2c2c2a;
    font-size: 27rpx;
    font-weight: 500;
}

.ghost-btn {
    background: #ffffff;
    color: #8b5e3c;
    border: 1rpx solid #8b5e3c;
    font-size: 30rpx;
    font-weight: 500;
    margin-bottom: 20rpx;
}

.danger-btn {
    background: #e24b4a;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 500;
}

.about {
    padding: 26rpx 30rpx;
}

.about-text {
    font-size: 25rpx;
    color: #888780;
    line-height: 1.7;
    white-space: pre-line;
}

/* 每日提醒卡片 */
.section-head {
    font-size: 29rpx;
    font-weight: 600;
    color: #2c2c2a;
    padding: 24rpx 0 4rpx;
}

.time-value {
    color: #8b5e3c;
    font-weight: 600;
}

.reminder-tip {
    font-size: 24rpx;
    color: #9b8f7d;
    line-height: 1.6;
    padding: 18rpx 0 20rpx;
}

.ghost-btn.slim {
    font-size: 27rpx;
    padding: 0 24rpx;
    height: 68rpx;
    line-height: 68rpx;
    margin-bottom: 24rpx;
}

/* 隐藏分享画布 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}
