.page {
    padding: 24rpx 32rpx 60rpx;
}

.card {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
    padding: 10rpx 30rpx;
    margin-bottom: 28rpx;
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26rpx 0;
    border-bottom: 0.5rpx solid rgba(44, 44, 42, 0.08);
}

.info-row:last-child {
    border-bottom: none;
}

.label {
    color: #888780;
    font-size: 27rpx;
}

.value {
    color: #2c2c2a;
    font-size: 27rpx;
    font-weight: 500;
}

.ghost-btn {
    background: #ffffff;
    color: #8b5e3c;
    border: 1rpx solid #8b5e3c;
    font-size: 30rpx;
    font-weight: 500;
    margin-bottom: 20rpx;
}

.danger-btn {
    background: #e24b4a;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 500;
}

.about {
    padding: 26rpx 30rpx;
}

.about-text {
    font-size: 25rpx;
    color: #888780;
    line-height: 1.7;
    white-space: pre-line;
}
