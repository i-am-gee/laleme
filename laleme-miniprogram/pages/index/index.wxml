<view class="page">
    <!-- iOS Large Title -->
    <view class="nav-bar {{statusClass}}" style="padding-top: {{navTop}}px;">
        <view class="nav-main">
            <view class="nav-title">拉了么</view>
            <view class="nav-sub">{{dateText}} · <text class="nav-state {{statusClass}}">{{statusSub}}</text></view>
        </view>
    </view>

    <!-- 好友挑战横幅 -->
    <view class="challenge-banner" wx:if="{{challenge}}">
        <view class="challenge-text">一位好友向你发起挑战：连续打卡 {{challenge.streak}} 天，本月 {{challenge.month}} 次。接招！</view>
        <view class="challenge-close" bindtap="dismissChallenge">✕</view>
    </view>

    <!-- 主视觉：居中的大圆按钮 -->
    <view class="hero {{statusClass}} {{shareBadge ? 'is-badge' : ''}}">
        <view class="fab-wrap">
            <view class="fab-halo"></view>
            <view class="fab {{fabPressed ? 'fab-pressed' : ''}}" hover-class="fab-hover" bindtouchstart="onFabTouchStart" bindtap="onFabTap">
                <text class="fab-emoji">💩</text>
                <text class="fab-label">记一次</text>
                <view class="fab-ripple" wx:if="{{fabPressed}}"></view>
            </view>
        </view>

        <!-- iOS 分组统计：数字拉霸滚动 -->
        <view class="chips">
            <view class="chip">
                <view class="chip-v">
                    <roll-number value="{{streakNum}}" text="{{streakFallback}}" suffix="天" size="44" suffix-size="24" />
                </view>
                <text class="chip-k">连续记录</text>
            </view>
            <view class="chip">
                <view class="chip-v">
                    <roll-number value="{{monthCountNum}}" suffix="次" size="44" suffix-size="24" />
                </view>
                <text class="chip-k">近 30 天</text>
            </view>
        </view>
    </view>

    <!-- 本月打卡日历：左右滑动切月，点某天看当日明细 -->
    <view
        class="card cal-card"
        wx:if="{{calendar}}"
        bindtouchstart="onCalTouchStart"
        bindtouchend="onCalTouchEnd"
    >
        <view class="cal-title">
            <view class="cal-month-wrap">
                <view class="cal-nav" hover-class="cal-nav-hover" catchtap="onMonthPrev">
                    <view class="cal-arrow left"></view>
                </view>
                <text class="cal-month">{{calendar.monthLabel}}</text>
                <view class="cal-nav {{monthOffset >= 0 ? 'off' : ''}}" hover-class="cal-nav-hover" catchtap="onMonthNext">
                    <view class="cal-arrow right"></view>
                </view>
            </view>
            <text class="cal-count">已打 {{calendar.activeDays}} 天</text>
        </view>
        <view class="cal-week">
            <text class="cal-wd">一</text><text class="cal-wd">二</text><text class="cal-wd">三</text><text class="cal-wd">四</text><text class="cal-wd">五</text><text class="cal-wd">六</text><text class="cal-wd">日</text>
        </view>
        <view class="cal-grid">
            <view
                class="cal-cell {{item.blank ? 'blank' : ''}} {{item.pooped ? 'pooped' : ''}} {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}}"
                wx:for="{{calendar.cells}}"
                wx:key="index"
                data-day="{{item.day}}"
                data-count="{{item.count}}"
                bindtap="onDayTap"
            >
                <view class="cal-poop" wx:if="{{item.pooped}}">💩</view>
                <view class="cal-num" wx:elif="{{!item.blank}}">{{item.day}}</view>
                <view class="cal-badge" wx:if="{{item.count > 1}}">{{item.count}}</view>
            </view>
        </view>

        <!-- 最近一次：作为日历卡的脚注行，不再单独占一张卡 -->
        <view class="last-line">
            <text class="last-k">最近一次</text>
            <view class="last-v">
                <text class="last-seg">{{lastTime}}</text>
                <text class="last-seg" wx:if="{{lastDur}}">{{lastDur}}</text>
                <text class="last-seg" wx:if="{{lastShape}}">{{lastShape}}</text>
            </view>
        </view>
    </view>

    <!-- 喊好友挑战：日历下方，与统计页共用同一个组件 -->
    <view class="cb-slot">
        <challenge-btn id="challengeBtn" />
    </view>
</view>

<!-- 成就庆祝动画：打卡成功 / 获得称号 -->
<view class="celebrate-mask {{celebrateGrand ? 'grand' : ''}}" wx:if="{{showCelebrate}}" bindtap="hideCelebrate">
    <view
        class="confetti-piece {{item.round ? 'round' : ''}}"
        wx:for="{{confetti}}"
        wx:key="index"
        style="left: {{item.left}}%; width: {{item.size}}rpx; height: {{item.round ? item.size : item.size * 2}}rpx; background: {{item.color}}; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s;"
    ></view>
    <view class="fw fw1"></view>
    <view class="fw fw2"></view>
    <view class="fw fw3"></view>
    <view class="celebrate-center">
        <view class="star-man">{{celebrateGrand ? '👑' : '🌟'}}</view>
        <view class="star-poop">💩</view>
        <view class="celebrate-title">{{celebrateTitle}}</view>
        <view class="celebrate-sub">{{celebrateText}}</view>
    </view>
</view>

<!-- 隐私保护指引弹窗 -->
<view class="privacy-mask" wx:if="{{showPrivacy}}">
    <view class="privacy-card">
        <view class="privacy-title">隐私保护指引</view>
        <scroll-view scroll-y class="privacy-body">
            <text class="privacy-text">{{privacySummary}}</text>
        </scroll-view>
        <view class="privacy-link" bindtap="goPrivacyPage">查看「{{privacyContractName}}」全文 ></view>
        <button
            class="privacy-agree"
            id="agree-btn"
            open-type="agreePrivacyAuthorization"
            bindagree="onPrivacyAgree"
            bindtap="onPrivacyAgree"
        >同意并继续</button>
        <view class="privacy-decline" bindtap="onPrivacyDecline">不同意</view>
    </view>
</view>

<!-- 记录抽屉：从底部拉起，可下滑收起 -->
<page-container
    show="{{sheetShow}}"
    position="bottom"
    round="{{true}}"
    overlay="{{true}}"
    duration="{{300}}"
    z-index="{{800}}"
    close-on-slide-down="{{true}}"
    custom-style="background:#ffffff;border-radius:32rpx 32rpx 0 0;"
    bind:beforeleave="onSheetLeave"
    bind:clickoverlay="onSheetOverlay"
>
    <view class="sheet">
        <view class="sheet-bar"></view>
        <record-form id="recordForm" bind:saved="onSheetSaved" bind:deleted="onSheetSaved" />
    </view>
</page-container>

<!-- 分享海报绘制画布（不可见） -->
<canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
