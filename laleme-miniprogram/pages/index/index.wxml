<view class="page">
    <!-- iOS Large Title + 标题行右侧的挑战好友入口 -->
    <view class="nav-bar {{statusClass}}" style="padding-top: {{navTop}}px;">
        <view class="nav-main">
            <view class="nav-title">拉了么</view>
            <view class="nav-sub">{{dateText}} · <text class="nav-state {{statusClass}}">{{statusSub}}</text></view>
        </view>
        <button class="nav-share" hover-class="nav-share-hover" open-type="share" bindtouchstart="onShareTouch">
            <image class="nav-share-icon" src="/assets/actions/share.png" mode="aspectFit" />
            <text class="nav-share-text">挑战</text>
        </button>
    </view>

    <!-- 好友挑战横幅 -->
    <view class="challenge-banner" wx:if="{{challenge}}">
        <view class="challenge-text">一位好友向你发起挑战：连续打卡 {{challenge.streak}} 天，本月 {{challenge.month}} 次。接招！</view>
        <view class="challenge-close" bindtap="dismissChallenge">✕</view>
    </view>

    <!-- 主视觉：居中的大圆按钮 -->
    <view class="hero {{statusClass}}">
        <view class="fab-wrap">
            <view class="fab-halo"></view>
            <view class="fab {{fabPressed ? 'fab-pressed' : ''}}" hover-class="fab-hover" bindtouchstart="onFabTouchStart" bindtap="onFabTap">
                <text class="fab-emoji">💩</text>
                <text class="fab-label">记一次</text>
                <view class="fab-ripple" wx:if="{{fabPressed}}"></view>
            </view>
        </view>

        <!-- iOS 分组统计：数字拉霸滚动 -->
        <view class="chips">
            <view class="chip">
                <view class="chip-v">
                    <roll-number value="{{streakNum}}" text="{{streakFallback}}" suffix="天" size="44" suffix-size="24" />
                </view>
                <text class="chip-k">连续记录</text>
            </view>
            <view class="chip">
                <view class="chip-v">
                    <roll-number value="{{monthCountNum}}" suffix="次" size="44" suffix-size="24" />
                </view>
                <text class="chip-k">近 30 天</text>
            </view>
        </view>
    </view>

    <!-- 本月打卡日历：左右滑动切月，点某天看当日明细 -->
    <view
        class="card cal-card"
        wx:if="{{calendar}}"
        bindtouchstart="onCalTouchStart"
        bindtouchend="onCalTouchEnd"
    >
        <view class="cal-title">
            <view class="cal-month-wrap">
                <view class="cal-nav" hover-class="cal-nav-hover" catchtap="onMonthPrev">
                    <view class="cal-arrow left"></view>
                </view>
                <text class="cal-month">{{calendar.monthLabel}}</text>
                <view class="cal-nav {{monthOffset >= 0 ? 'off' : ''}}" hover-class="cal-nav-hover" catchtap="onMonthNext">
                    <view class="cal-arrow right"></view>
                </view>
            </view>
            <text class="cal-count">已打 {{calendar.activeDays}} 天</text>
        </view>
        <view class="cal-week">
            <text class="cal-wd">一</text><text class="cal-wd">二</text><text class="cal-wd">三</text><text class="cal-wd">四</text><text class="cal-wd">五</text><text class="cal-wd">六</text><text class="cal-wd">日</text>
        </view>
        <view class="cal-grid">
            <view
                class="cal-cell {{item.blank ? 'blank' : ''}} {{item.pooped ? 'pooped' : ''}} {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}}"
                wx:for="{{calendar.cells}}"
                wx:key="index"
                data-day="{{item.day}}"
                data-count="{{item.count}}"
                bindtap="onDayTap"
            >
                <text class="cal-poop" wx:if="{{item.pooped}}">💩</text>
                <text class="cal-num" wx:elif="{{!item.blank}}">{{item.day}}</text>
                <view class="cal-badge" wx:if="{{item.count > 1}}">{{item.count}}</view>
            </view>
        </view>
    </view>

    <!-- 最近一次：纯信息行，不再作为历史入口 -->
    <view class="last-line">
        <text class="last-k">最近一次</text>
        <view class="last-v">
            <text class="last-seg">{{lastTime}}</text>
            <text class="last-seg" wx:if="{{lastDur}}">{{lastDur}}</text>
            <text class="last-seg" wx:if="{{lastShape}}">{{lastShape}}</text>
        </view>
    </view>
</view>
