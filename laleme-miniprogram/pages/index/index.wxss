.page {
    /* 自定义 tabBar 不占页面布局，底部留出它的高度 */
    padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 120rpx);
}

/* 好友挑战横幅 */
.challenge-banner {
    display: flex;
    align-items: center;
    gap: 16rpx;
    background: #fcebeb;
    border: 1rpx solid #e24b4a;
    border-radius: 20rpx;
    padding: 18rpx 22rpx;
    margin-bottom: 18rpx;
}

.challenge-text {
    flex: 1;
    font-size: 25rpx;
    color: #a32d2d;
    line-height: 1.5;
}

.challenge-close {
    font-size: 28rpx;
    color: #888780;
    padding: 6rpx 10rpx;
}

/* 主视觉：居中的大圆按钮 */
.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6rpx 0 0;
    margin-bottom: 14rpx;
}

.hero-status {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
    margin-bottom: 6rpx;
}

.hero-title {
    font-size: 36rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.hero.notyet .hero-title {
    color: #854f0b;
}

.hero.done .hero-title {
    color: #0f6e56;
}

.hero-sep {
    font-size: 24rpx;
    color: #c0b6a8;
}

.hero-sub {
    font-size: 24rpx;
    opacity: 0.9;
}

.hero.notyet .hero-sub {
    color: #a9712a;
}

.hero.done .hero-sub {
    color: #2c8a6d;
}

/* 圆形按钮容器：留出光晕空间 */
.fab-wrap {
    position: relative;
    width: 340rpx;
    height: 340rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.fab-halo {
    position: absolute;
    width: 336rpx;
    height: 336rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 94, 60, 0.16) 0%, rgba(139, 94, 60, 0.06) 55%, rgba(139, 94, 60, 0) 72%);
    animation: haloBreathe 3.4s ease-in-out infinite;
}

@keyframes haloBreathe {
    0%, 100% { transform: scale(0.94); opacity: 0.8; }
    50% { transform: scale(1.06); opacity: 1; }
}

.fab {
    position: relative;
    overflow: hidden;
    width: 300rpx;
    height: 300rpx;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, #c08a5e 0%, #8b5e3c 52%, #5e3f28 100%);
    box-shadow: 0 22rpx 48rpx rgba(139, 94, 60, 0.42), 0 0 0 12rpx rgba(139, 94, 60, 0.08);
    animation: fabPulse 3.2s ease-in-out infinite;
    transition: transform 0.12s ease;
}

.fab-hover {
    transform: scale(0.95);
}

/* 按下：整圆压缩 + 表情抖动 */
.fab-pressed {
    animation: fabPulse 3.2s ease-in-out infinite, fabPress 0.32s ease;
}

.fab-pressed .fab-emoji {
    animation: poopWobble 0.5s ease;
}

/* 涟漪 */
.fab-ripple {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 300rpx;
    height: 300rpx;
    margin-left: -150rpx;
    margin-top: -150rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    animation: fabRipple 0.55s ease-out forwards;
}

@keyframes fabPress {
    0% { transform: scale(1); }
    45% { transform: scale(0.9); }
    100% { transform: scale(1); }
}

@keyframes poopWobble {
    0% { transform: scale(1) rotate(0deg); }
    30% { transform: scale(1.22) rotate(-12deg); }
    60% { transform: scale(0.94) rotate(9deg); }
    100% { transform: scale(1) rotate(0deg); }
}

@keyframes fabRipple {
    0% { transform: scale(0.35); opacity: 0.85; }
    100% { transform: scale(1.25); opacity: 0; }
}

.fab-emoji {
    position: relative;
    z-index: 1;
    font-size: 116rpx;
    line-height: 1;
}

.fab-label {
    position: relative;
    z-index: 1;
    display: block;
    margin-top: 12rpx;
    font-size: 36rpx;
    font-weight: 700;
    letter-spacing: 6rpx;
    text-indent: 6rpx;
    color: #ffffff;
}

@keyframes fabPulse {
    0%, 100% {
        box-shadow: 0 22rpx 48rpx rgba(139, 94, 60, 0.42), 0 0 0 12rpx rgba(139, 94, 60, 0.08);
    }
    50% {
        box-shadow: 0 26rpx 60rpx rgba(139, 94, 60, 0.48), 0 0 0 22rpx rgba(139, 94, 60, 0.04);
    }
}

/* 数据 chip：按钮下方一行 */
.chips {
    display: flex;
    gap: 14rpx;
    margin-top: 6rpx;
}

.chip {
    background: rgba(255, 255, 255, 0.86);
    border: 0.5rpx solid rgba(139, 94, 60, 0.16);
    border-radius: 999rpx;
    padding: 8rpx 20rpx;
    display: flex;
    align-items: baseline;
    gap: 8rpx;
    box-shadow: 0 4rpx 12rpx rgba(139, 94, 60, 0.06);
}

.chip-v {
    font-size: 26rpx;
    font-weight: 700;
    color: #6b4830;
    line-height: 1.2;
}

.chip-k {
    font-size: 19rpx;
    color: #a3978a;
}

.card {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
}

/* 打卡日历 */
.cal-card {
    padding: 22rpx 24rpx 18rpx;
}

.cal-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14rpx;
    padding: 0 4rpx;
}

.cal-month {
    font-size: 27rpx;
    font-weight: 600;
}

.cal-count {
    font-size: 23rpx;
    color: #8b5e3c;
}

.cal-week {
    display: flex;
    margin-bottom: 4rpx;
}

.cal-wd {
    flex: 1;
    text-align: center;
    font-size: 20rpx;
    color: #b0a394;
}

.cal-grid {
    display: flex;
    flex-wrap: wrap;
}

/* 日历格子：64rpx 高保证可点区域 */
.cal-cell {
    position: relative;
    width: calc(100% / 7);
    height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin-bottom: 8rpx;
}

.cal-num {
    font-size: 23rpx;
    color: #2c2c2a;
}

.cal-cell.future .cal-num {
    color: #cdc8be;
}

.cal-cell.pooped {
    background: #faeeda;
    border-radius: 14rpx;
    width: calc(100% / 7 - 6rpx);
    margin: 0 3rpx 8rpx;
    box-shadow: inset 0 0 0 1rpx rgba(139, 94, 60, 0.14);
}

.cal-poop {
    font-size: 38rpx;
    line-height: 1;
}

.cal-cell.today {
    border: 2rpx solid #8b5e3c;
    border-radius: 14rpx;
    width: calc(100% / 7 - 6rpx);
    margin: 0 3rpx 8rpx;
}

.cal-cell.today.pooped {
    border-color: #5e3f28;
    box-shadow: 0 0 0 4rpx rgba(139, 94, 60, 0.16);
}

/* 同一天 2 次及以上的角标：贴在格子右上角内侧，避免跨到相邻格 */
.cal-badge {
    position: absolute;
    top: -4rpx;
    right: 2rpx;
    min-width: 24rpx;
    height: 24rpx;
    line-height: 24rpx;
    padding: 0 4rpx;
    border-radius: 12rpx;
    background: #f0b27a;
    color: #ffffff;
    font-size: 17rpx;
    font-weight: 700;
    text-align: center;
    box-shadow: 0 2rpx 6rpx rgba(180, 120, 60, 0.35);
}

/* 最近一次 */
.last-line {
    display: flex;
    align-items: center;
    gap: 12rpx;
    padding: 16rpx 8rpx 4rpx;
}

.last-k {
    font-size: 22rpx;
    color: #a0968a;
    flex-shrink: 0;
}

.last-v {
    font-size: 23rpx;
    color: #5c4a38;
    flex: 1;
    text-align: right;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ghost-btn {
    background: #ffffff;
    color: #8b5e3c;
    border: 1rpx solid #8b5e3c;
    font-size: 31rpx;
    font-weight: 500;
    height: 96rpx;
    line-height: 96rpx;
    padding: 0;
    width: 100% !important;
    box-sizing: border-box;
    border-radius: 48rpx;
    margin: 14rpx 0 0;
}

.ghost-btn::after {
    border: none;
}

.footnote {
    text-align: center;
    color: #8b5e3c;
    font-size: 25rpx;
    padding: 18rpx 0 4rpx;
}

/* 成就庆祝动画 */
.celebrate-mask {
    position: fixed;
    inset: 0;
    background: rgba(26, 22, 18, 0.78);
    z-index: 999;
    overflow: hidden;
}

.confetti-piece {
    position: absolute;
    top: -40rpx;
    border-radius: 4rpx;
    opacity: 0.9;
    animation-name: confetti-fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
}

.confetti-piece.round {
    border-radius: 50%;
}

@keyframes confetti-fall {
    0% {
        transform: translateY(-40rpx) rotate(0deg);
        opacity: 0.9;
    }
    100% {
        transform: translateY(1400rpx) rotate(540deg);
        opacity: 0.4;
    }
}

.fw {
    position: absolute;
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    opacity: 0;
    border-width: 6rpx;
    border-style: solid;
    animation: firework 2s ease-out infinite;
}

.fw1 {
    left: 14%;
    top: 22%;
    border-color: #fac775;
    animation-delay: 0.1s;
}

.fw2 {
    left: 72%;
    top: 28%;
    border-color: #ed93b1;
    animation-delay: 0.7s;
}

.fw3 {
    left: 44%;
    top: 12%;
    border-color: #85b7eb;
    animation-delay: 1.3s;
}

@keyframes firework {
    0% {
        transform: scale(0.2);
        opacity: 0;
    }
    15% {
        opacity: 1;
    }
    55% {
        transform: scale(3.2);
        opacity: 0.85;
    }
    100% {
        transform: scale(3.6);
        opacity: 0;
    }
}

.celebrate-center {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    text-align: center;
    animation: star-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.star-man {
    font-size: 170rpx;
    line-height: 1;
    display: inline-block;
    animation: star-bounce 1s ease-in-out infinite;
    text-shadow: 0 0 60rpx rgba(250, 199, 117, 0.9);
}

.star-poop {
    font-size: 72rpx;
    display: inline-block;
    margin-left: 8rpx;
    vertical-align: bottom;
    animation: star-bounce 1s ease-in-out 0.2s infinite;
}

.celebrate-title {
    font-size: 48rpx;
    font-weight: 700;
    color: #ffffff;
    margin-top: 22rpx;
    text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.celebrate-sub {
    font-size: 28rpx;
    color: #fac775;
    margin-top: 10rpx;
}

@keyframes star-pop {
    0% {
        transform: scale(0.2);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes star-bounce {
    0%, 100% {
        transform: translateY(0) rotate(-4deg);
    }
    50% {
        transform: translateY(-26rpx) rotate(4deg);
    }
}

/* 隐私保护指引弹窗 */
.privacy-mask {
    position: fixed;
    inset: 0;
    background: rgba(26, 22, 18, 0.6);
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48rpx;
}

.privacy-card {
    width: 100%;
    background: #ffffff;
    border-radius: 28rpx;
    padding: 36rpx 32rpx 28rpx;
    box-sizing: border-box;
}

.privacy-title {
    font-size: 34rpx;
    font-weight: 700;
    text-align: center;
    margin-bottom: 20rpx;
}

.privacy-body {
    max-height: 300rpx;
}

.privacy-text {
    font-size: 25rpx;
    color: #444441;
    line-height: 1.8;
    white-space: pre-line;
}

.privacy-link {
    font-size: 24rpx;
    color: #8b5e3c;
    text-align: center;
    padding: 18rpx 0;
}

.privacy-agree {
    background: #8b5e3c;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    border-radius: 20rpx;
    margin-bottom: 14rpx;
}

.privacy-agree::after {
    border: none;
}

.privacy-decline {
    text-align: center;
    font-size: 27rpx;
    color: #888780;
    padding: 8rpx 0 4rpx;
}

/* 分享海报画布：移出可视区域 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}

/* 记录抽屉 */
.sheet {
    background: #ffffff;
    border-radius: 28rpx 28rpx 0 0;
    /* 自定义 tabBar 是原生层，始终盖在页面之上，所以给它让出高度 */
    padding-bottom: calc(env(safe-area-inset-bottom) + 108rpx);
    max-height: 92vh;
    overflow-y: auto;
}

.sheet-bar {
    width: 76rpx;
    height: 8rpx;
    border-radius: 4rpx;
    background: #e0d6c8;
    margin: 16rpx auto 10rpx;
}
