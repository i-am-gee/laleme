/* ============================================================
   首页 · iOS 视觉语言
   ============================================================ */

.page {
    /* 自定义 tabBar 不占页面布局：底部留出 tabBar(约 100rpx) + 安全区 + 呼吸间距 */
    padding: 0 var(--sp-4) calc(env(safe-area-inset-bottom) + 200rpx);
}

/* ---------- 标题行：左标题 + 右「挑战」胶囊 ---------- */
.nav-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3);
}

.nav-main {
    flex: 1;
    min-width: 0;
}

/* 挑战入口：实心品牌棕胶囊，纯白图标与文字，在浅色页面上第一眼就能看到 */
.nav-share {
    display: flex;
    align-items: center;
    gap: 8rpx;
    /* 微信 button 默认宽度 184px，必须显式覆盖 */
    width: auto !important;
    height: 64rpx;
    margin-top: 10rpx;
    padding: 0 22rpx 0 18rpx;
    border-radius: var(--r-full);
    background: var(--tint);
    box-shadow: 0 8rpx 20rpx rgba(139, 94, 60, 0.26);
    flex-shrink: 0;
    line-height: 1;
    transition: transform 0.2s var(--ease-spring), box-shadow 0.2s ease, background-color 0.12s ease;
}

.nav-share::after {
    border: none;
}

.nav-share-icon {
    width: 26rpx;
    height: 26rpx;
}

.nav-share-text {
    font-size: var(--t-footnote);
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.5rpx;
}

.nav-share-hover {
    background: var(--tint-strong);
    transform: scale(0.95);
    box-shadow: 0 4rpx 12rpx rgba(139, 94, 60, 0.22);
}

/* ---------- 好友挑战横幅：淡填充，无描边 ---------- */
.challenge-banner {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--fill-1);
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-3);
    margin-top: var(--sp-3);
}

.challenge-text {
    flex: 1;
    font-size: var(--t-footnote);
    color: var(--label-2);
    line-height: 1.55;
}

.challenge-close {
    font-size: var(--t-subhead);
    color: var(--label-3);
    padding: 4rpx 8rpx;
}

/* ---------- 副标题里的状态词随状态变色，日期保持中性 ---------- */
.nav-state.done {
    color: #248a63;
    font-weight: 500;
}

.nav-state.notyet {
    color: var(--tint-strong);
    font-weight: 500;
}

/* ---------- 主视觉：居中大圆按钮 ---------- */
.hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8rpx 0 0;
}

/* 圆按钮容器 */
.fab-wrap {
    position: relative;
    width: 312rpx;
    height: 312rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 引导光晕：呼吸式外扩，把视线引向主按钮 */
.fab-halo {
    position: absolute;
    width: 288rpx;
    height: 288rpx;
    border-radius: 50%;
    background: var(--tint-soft);
    animation: haloBreathe 3s ease-in-out infinite;
}

@keyframes haloBreathe {
    0%, 100% {
        transform: scale(0.90);
        opacity: 0.45;
    }
    50% {
        transform: scale(1.10);
        opacity: 1;
    }
}

/* 实心圆按钮：iOS 用纯色，不用渐变 */
.fab {
    position: relative;
    overflow: hidden;
    width: 264rpx;
    height: 264rpx;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--tint);
    box-shadow: 0 16rpx 40rpx rgba(139, 94, 60, 0.26);
    transition: transform 0.22s var(--ease-spring), box-shadow 0.22s ease;
}

.fab-hover {
    transform: scale(0.94);
    box-shadow: 0 8rpx 24rpx rgba(139, 94, 60, 0.22);
}

/* 按下：弹性缩放，涟漪保留但收敛 */
.fab-pressed {
    animation: fabPress 0.36s var(--ease-spring);
}

.fab-pressed .fab-emoji {
    animation: poopWobble 0.5s var(--ease-spring);
}

.fab-ripple {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 288rpx;
    height: 288rpx;
    margin-left: -144rpx;
    margin-top: -144rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    animation: fabRipple 0.6s var(--ease-sheet) forwards;
}

@keyframes fabPress {
    0% { transform: scale(1); }
    45% { transform: scale(0.9); }
    100% { transform: scale(1); }
}

@keyframes poopWobble {
    0% { transform: scale(1) rotate(0deg); }
    30% { transform: scale(1.16) rotate(-8deg); }
    65% { transform: scale(0.96) rotate(5deg); }
    100% { transform: scale(1) rotate(0deg); }
}

@keyframes fabRipple {
    0% { transform: scale(0.4); opacity: 0.7; }
    100% { transform: scale(1.2); opacity: 0; }
}

.fab-emoji {
    position: relative;
    z-index: 1;
    font-size: 96rpx;
    line-height: 1;
}

.fab-label {
    position: relative;
    z-index: 1;
    display: block;
    margin-top: var(--sp-2);
    font-size: var(--t-title3);
    font-weight: 600;
    letter-spacing: 4rpx;
    text-indent: 4rpx;
    color: #ffffff;
}

/* ---------- 统计双栏卡：iOS 分组统计 ---------- */
.chips {
    display: flex;
    align-items: stretch;
    width: 100%;
    background: var(--bg-card);
    border-radius: var(--r-lg);
    margin-top: var(--sp-2);
    padding: var(--sp-2) 0;
}

.chip {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rpx;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
}

.chip + .chip {
    border-left: 0.5rpx solid var(--sep);
    transform: scaleY(1);
}

/* 数字容器：接拉霸组件，字号由组件 size 控制 */
.chip-v {
    display: flex;
    align-items: flex-end;
    height: 54rpx;
    font-weight: 600;
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.chip-k {
    font-size: var(--t-footnote);
    color: var(--label-2);
}

/* ---------- 日历卡 ---------- */
.cal-card {
    padding: var(--sp-3) var(--sp-3) 0;
    margin-top: var(--sp-2);
}

.cal-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--sp-2);
}

/* 月份切换：左箭头 + 月份 + 右箭头 */
.cal-month-wrap {
    display: flex;
    align-items: center;
    margin-left: -12rpx;
}

.cal-nav {
    width: 56rpx;
    height: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

.cal-nav-hover {
    background: var(--fill-1);
}

.cal-arrow {
    width: 14rpx;
    height: 14rpx;
    border-right: 3rpx solid var(--label-3);
    border-bottom: 3rpx solid var(--label-3);
}

.cal-arrow.left {
    transform: rotate(135deg);
}

.cal-arrow.right {
    transform: rotate(-45deg);
}

/* 已在当前月时，右箭头置灰 */
.cal-nav.off .cal-arrow {
    border-color: var(--label-4);
}

.cal-month {
    font-size: var(--t-headline);
    font-weight: 600;
    color: var(--label);
    min-width: 92rpx;
    text-align: center;
}

.cal-count {
    font-size: var(--t-footnote);
    color: var(--label-2);
}

.cal-week {
    display: flex;
    margin-bottom: 4rpx;
}

.cal-wd {
    flex: 1;
    text-align: center;
    font-size: var(--t-caption2);
    color: var(--label-3);
    font-weight: 500;
}

.cal-grid {
    display: flex;
    flex-wrap: wrap;
}

/* 日历格子：72rpx 高，行高固定，切月不跳动 */
.cal-cell {
    position: relative;
    width: calc(100% / 7);
    height: 72rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}

/* 圆形容器：所有状态共用同一尺寸，只换填充 */
.cal-cell .cal-num,
.cal-cell .cal-poop {
    width: 56rpx;
    height: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-sizing: border-box;
}

.cal-num {
    font-size: var(--t-callout);
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.cal-cell.future .cal-num {
    color: var(--label-4);
}

/* 有记录：淡填充圆 */
.cal-cell.pooped .cal-poop {
    background: var(--tint-soft);
    font-size: 34rpx;
    line-height: 1;
}

/* 今天：加一圈实色环 */
.cal-cell.today .cal-num,
.cal-cell.today .cal-poop {
    box-shadow: inset 0 0 0 3rpx var(--tint);
    font-weight: 600;
}

/* 同一天 2 次及以上：极简角标 */
.cal-badge {
    position: absolute;
    top: 2rpx;
    right: 4rpx;
    min-width: 22rpx;
    height: 22rpx;
    line-height: 22rpx;
    padding: 0 4rpx;
    border-radius: var(--r-full);
    background: var(--tint);
    color: #ffffff;
    font-size: 16rpx;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
}

/* ---------- 最近一次：日历卡内的脚注行 ---------- */
.last-line {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 72rpx;
    /* 负 margin 抵消卡片左右内边距，让分隔线拉满整卡宽度 */
    margin: var(--sp-2) calc(var(--sp-3) * -1) 0;
    padding: 0 var(--sp-4);
}

.last-line::before {
    content: "";
    position: absolute;
    left: var(--sp-4);
    right: 0;
    top: 0;
    height: 0.5rpx;
    background: var(--sep);
}

.last-k {
    font-size: var(--t-body);
    color: var(--label);
    flex-shrink: 0;
}

/* 分段折行：放得下就一行，放不下只在「·」处换行，不会把词切断 */
.last-v {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    font-size: var(--t-callout);
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
}

.last-seg {
    white-space: nowrap;
}

.last-seg + .last-seg::before {
    content: '·';
    margin: 0 var(--sp-1);
    color: var(--label-4);
}

/* ============================================================
   成就庆祝（瞬时态，允许一点情绪，但不破坏克制）
   ============================================================ */
.celebrate-mask {
    position: fixed;
    inset: 0;
    background: rgba(18, 16, 14, 0.82);
    z-index: 999;
    overflow: hidden;
}

.confetti-piece {
    position: absolute;
    top: -40rpx;
    border-radius: 3rpx;
    opacity: 0.85;
    animation-name: confetti-fall;
    animation-timing-function: linear;
    animation-iteration-count: 1;
}

.confetti-piece.round {
    border-radius: 50%;
}

@keyframes confetti-fall {
    0% {
        transform: translateY(-40rpx) rotate(0deg);
        opacity: 0.85;
    }
    100% {
        transform: translateY(1400rpx) rotate(540deg);
        opacity: 0;
    }
}

.fw {
    position: absolute;
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    opacity: 0;
    border-width: 4rpx;
    border-style: solid;
    animation: firework 2.4s var(--ease-sheet) 1;
}

.fw1 {
    left: 14%;
    top: 22%;
    border-color: rgba(255, 199, 117, 0.9);
    animation-delay: 0.1s;
}

.fw2 {
    left: 72%;
    top: 28%;
    border-color: rgba(237, 147, 177, 0.9);
    animation-delay: 0.7s;
}

.fw3 {
    left: 44%;
    top: 12%;
    border-color: rgba(133, 183, 235, 0.9);
    animation-delay: 1.3s;
}

@keyframes firework {
    0% {
        transform: scale(0.3);
        opacity: 0;
    }
    20% {
        opacity: 0.9;
    }
    60% {
        transform: scale(2.8);
        opacity: 0.7;
    }
    100% {
        transform: scale(3.4);
        opacity: 0;
    }
}

.celebrate-center {
    position: absolute;
    left: 0;
    right: 0;
    top: 32%;
    text-align: center;
    animation: star-pop 0.62s var(--ease-spring);
}

.star-man {
    font-size: 160rpx;
    line-height: 1;
    display: inline-block;
    animation: star-bounce 1.6s ease-in-out infinite;
}

.star-poop {
    font-size: 68rpx;
    display: inline-block;
    margin-left: var(--sp-1);
    vertical-align: bottom;
    animation: star-bounce 1.6s ease-in-out 0.24s infinite;
}

.celebrate-title {
    font-size: var(--t-title1);
    font-weight: 600;
    color: #ffffff;
    margin-top: var(--sp-3);
    letter-spacing: -0.4rpx;
}

.celebrate-sub {
    font-size: var(--t-callout);
    color: rgba(255, 255, 255, 0.66);
    margin-top: var(--sp-1);
}

@keyframes star-pop {
    0% {
        transform: scale(0.7);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes star-bounce {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-20rpx);
    }
}

/* ============================================================
   隐私弹窗：iOS Alert 体例
   ============================================================ */
.privacy-mask {
    position: fixed;
    inset: 0;
    background: rgba(18, 16, 14, 0.42);
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-6) var(--sp-5);
}

.privacy-card {
    width: 100%;
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-5) var(--sp-4) var(--sp-4);
    box-sizing: border-box;
    animation: alertIn 0.28s var(--ease-spring);
}

@keyframes alertIn {
    0% {
        transform: scale(0.92);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.privacy-title {
    font-size: var(--t-title3);
    font-weight: 600;
    text-align: center;
    margin-bottom: var(--sp-2);
    letter-spacing: -0.3rpx;
}

.privacy-body {
    max-height: 320rpx;
}

.privacy-text {
    font-size: var(--t-footnote);
    color: var(--label-2);
    line-height: 1.7;
    white-space: pre-line;
}

.privacy-link {
    font-size: var(--t-footnote);
    color: var(--tint);
    text-align: center;
    padding: var(--sp-3) 0;
}

.privacy-agree {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 96rpx;
    background: var(--tint);
    color: #ffffff;
    font-size: var(--t-body);
    font-weight: 600;
    border-radius: var(--r-full);
    margin-bottom: var(--sp-2);
}

.privacy-agree::after {
    border: none;
}

.privacy-decline {
    text-align: center;
    font-size: var(--t-subhead);
    color: var(--label-2);
    padding: var(--sp-2) 0 4rpx;
}

/* ============================================================
   分享海报画布：移出可视区域
   ============================================================ */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}

/* ============================================================
   记录抽屉：iOS Sheet 体例
   ============================================================ */
.sheet {
    background: var(--bg-card);
    /* 自定义 tabBar 是原生层，始终盖在页面之上，所以给它让出高度 */
    padding-bottom: calc(env(safe-area-inset-bottom) + 108rpx);
    max-height: 92vh;
    overflow-y: auto;
}

/* 抓手条：iOS Sheet 的标志性元素 */
.sheet-bar {
    width: 72rpx;
    height: 10rpx;
    border-radius: var(--r-full);
    background: var(--fill-3);
    margin: var(--sp-2) auto var(--sp-1);
}
