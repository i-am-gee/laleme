<view class="page">
    <view class="nav-bar" style="padding-top: {{navTop}}px;">
        <view class="nav-title">好友</view>
        <view class="nav-sub">只看得见彼此有没有记录</view>
    </view>

    <block wx:if="{{!ready}}">
        <view class="card card-pad fs-empty">
            <view class="fs-empty-t">好友功能需要先开启云同步</view>
            <view class="fs-empty-d">开启后，你和好友只看得到彼此「今天有没有记录」，看不到任何一条明细。</view>
            <view class="fs-empty-btn" bindtap="goMe">去开启</view>
        </view>
    </block>

    <block wx:else>
        <!-- 我 -->
        <view class="card card-pad me-card">
            <view class="me-left">
                <image class="me-badge" src="{{meIcon}}" mode="aspectFit" />
                <view class="me-main">
                    <view class="me-name">{{me.nick}}</view>
                    <view class="me-sub">{{me.tierName}} · 连续 {{me.streak}} 天</view>
                </view>
            </view>
            <view class="me-today {{me.todayDone ? 'on' : ''}}">{{me.todayDone ? '今天已记录' : '今天还没'}}</view>
        </view>

        <!-- 排名 -->
        <view class="card card-pad">
            <view class="sec-head">
                <text class="sec-title">近七天排名</text>
                <text class="sec-hint">按活跃天数</text>
            </view>
            <view class="rank-row {{item.isMe ? 'me' : ''}}" wx:for="{{rank}}" wx:key="id">
                <text class="rank-no">{{item.rank}}</text>
                <text class="rank-nick">{{item.nick}}</text>
                <text class="rank-meta">{{item.weekDays}} 天 · {{item.tierName}}</text>
            </view>
            <view class="rank-foot">你排在第 {{myRank}} 名</view>
        </view>

        <!-- 好友 -->
        <view class="card card-pad">
            <view class="sec-head">
                <text class="sec-title">好友</text>
                <text class="sec-hint">{{friendCount}} 人</text>
            </view>

            <view class="fr-row" wx:for="{{flist}}" wx:key="id">
                <view class="fr-dot {{item.todayDone ? 'on' : ''}}"></view>
                <view class="fr-main">
                    <view class="fr-nick">{{item.nick}}</view>
                    <view class="fr-meta">连续 {{item.streak}} 天 · 近七天 {{item.weekDays}} 天</view>
                </view>
                <text class="fr-state">{{item.todayDone ? '已记录' : '还没'}}</text>
            </view>
            <view class="fr-empty" wx:if="{{!hasFriends}}">还没有好友。邀请一个，彼此看得见今天有没有记</view>
        </view>

        <!-- 提醒 -->
        <view class="card card-pad">
            <view class="sw-row">
                <view class="sw-main">
                    <view class="sw-label">接收好友打卡提醒</view>
                    <view class="sw-sub">{{quota ? '还剩 ' + quota + ' 次可以提醒你' : '点一次授权，攒一次提醒'}}</view>
                </view>
                <switch class="sw" checked="{{friendNotify}}" color="#8b5e3c" bindchange="onToggleNotify" />
            </view>
        </view>

        <button class="primary-btn" hover-class="primary-hover" open-type="share" bindtouchstart="onShareTouch">
            邀请好友
        </button>

        <view class="fs-note">好友只看得到「今天有没有记录」「连续几天」，看不到任何一条明细。</view>
    </block>
</view>

<timer-bar />
