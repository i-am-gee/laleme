<view class="page">
    <!-- iOS Large Title -->
    <view class="nav-bar" style="padding-top: {{navTop}}px;">
        <view class="nav-title">统计</view>
    </view>

    <view class="seg">
        <view class="seg-item {{period === 'week' ? 'active' : ''}}" data-period="week" bindtap="setPeriod">近 7 天</view>
        <view class="seg-item {{period === 'month' ? 'active' : ''}}" data-period="month" bindtap="setPeriod">近 30 天</view>
        <view class="seg-item {{period === 'custom' ? 'active' : ''}}" data-period="custom" bindtap="setPeriod">自定义</view>
    </view>

    <!-- 自定义时间范围 -->
    <view class="range-bar" wx:if="{{period === 'custom'}}">
        <picker mode="date" value="{{rangeStart}}" bindchange="onRangeStart">
            <view class="range-pick">{{rangeStart || '开始日期'}} <text class="range-arrow">▾</text></view>
        </picker>
        <text class="range-dash">至</text>
        <picker mode="date" value="{{rangeEnd}}" bindchange="onRangeEnd">
            <view class="range-pick">{{rangeEnd || '结束日期'}} <text class="range-arrow">▾</text></view>
        </picker>
        <text class="range-label" wx:if="{{rangeLabel}}">{{rangeLabel}}</text>
    </view>

        <view class="metrics">
            <view class="metric">
                <view class="num">
                    <roll-number value="{{countText}}" size="44" />
                </view>
                <view class="lbl">次数</view>
            </view>
            <view class="metric">
                <view class="num">
                    <roll-number value="{{avgNum}}" text="{{avgFallback}}" suffix="分" size="44" suffix-size="24" />
                </view>
                <view class="lbl">平均时长</view>
            </view>
            <view class="metric">
                <view class="num">
                    <roll-number value="{{streakText}}" size="44" />
                </view>
                <view class="lbl">连续天数</view>
            </view>
        </view>

        <view class="card">
            <view class="card-title">布里斯托性状分布</view>
            <view wx:if="{{!hasDist}}" class="empty-small">该时段暂无性状数据</view>
            <view class="bar-row" wx:for="{{dist}}" wx:key="key">
                <text class="bar-label">{{item.label}}</text>
                <view class="bar-track">
                    <view class="bar-fill level-{{item.level}}" style="width: {{item.pct}}%;"></view>
                </view>
                <text class="bar-pct">{{item.pct}}%</text>
            </view>
        </view>

        <view class="section-row">
            <text class="section-title">成就墙</text>
            <text class="section-meta">已点亮 {{gotCount}} / 4</text>
        </view>
        <view class="ach-grid">
            <view class="ach {{item.got ? 'got' : ''}}" wx:for="{{achList}}" wx:key="id" data-id="{{item.id}}" bindtap="onBadgeTap">
                <image class="ach-icon" src="{{item.icon}}" mode="aspectFit" />
                <view class="a-name">{{item.name}}</view>
                <view class="a-desc">{{item.desc}}</view>
            </view>
        </view>

        <!-- 与首页同一个分享组件，进度与称号共享 -->
        <view class="cb-area">
            <challenge-btn id="challengeBtn" />
        </view>
</view>

<!-- 分享海报绘制画布（不可见） -->
<canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
