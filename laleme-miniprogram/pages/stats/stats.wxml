<view class="page">
    <!-- iOS Large Title -->
    <view class="nav-bar" style="padding-top: {{navTop}}px;">
        <view class="nav-title">段位</view>
    </view>

    <!-- 段位：只看连续天数，断签掉级 -->
    <view class="card rank-card">
        <view class="rk-head">
            <image class="rk-badge" src="{{rankIcon}}" mode="aspectFit" />
            <view class="rk-main">
                <text class="rk-name">{{rankName}}</text>
                <text class="rk-sub">{{rankSub}}</text>
            </view>
            <text class="rk-peak" wx:if="{{rankPeakName}}">最高 {{rankPeakName}}</text>
        </view>
        <view class="rk-track">
            <view class="rk-fill" style="width: {{rankPct}}%;"></view>
        </view>
        <view class="rk-next">{{rankNextLine}}</view>
        <!-- 解锁进度：每达成一档点亮一个便便图标，与首页「记一次」共用同一套 -->
        <view class="rk-ladder">
            <view class="rk-step {{item.on ? 'on' : ''}} {{item.cur ? 'cur' : ''}}" wx:for="{{rankTicks}}" wx:key="days">
                <view class="rk-line" wx:if="{{index < rankTicks.length - 1}}"></view>
                <view class="rk-rail">
                    <image class="rk-icon" src="{{item.icon}}" mode="aspectFit" />
                </view>
                <view class="rk-day">{{item.dayLabel}}</view>
                <view class="rk-brief">{{item.brief}}</view>
            </view>
        </view>
        <view class="rk-hint">{{rankHint}}</view>
    </view>

    <!-- 挑战入口：与晋级庆祝同一个按钮语言，宽度随内容区自适应 -->
    <button
        class="rank-cta"
        hover-class="rank-cta-hover"
        hover-stay-time="80"
        open-type="share"
        bindtouchstart="onShareTouch"
    >
        <image class="rank-cta-icon" src="/assets/actions/share-white.png" mode="aspectFit" />
        <text class="rank-cta-text">邀请好友挑战</text>
    </button>

    <!-- 好友 PK：紧接段位，方便直接拿段位去比 -->
    <!-- 好友：只看得见彼此今天有没有记录 -->
    <view class="card pk-entry" bindtap="openFriends" hover-class="pk-entry-press" hover-stay-time="80">
        <view class="pk-entry-main">
            <view class="pk-entry-t">好友</view>
            <view class="pk-entry-d">{{friendsLine}}</view>
        </view>
        <view class="chevron"></view>
    </view>

    <view class="seg">
        <view class="seg-item {{period === 'week' ? 'active' : ''}}" data-period="week" bindtap="setPeriod">近 7 天</view>
        <view class="seg-item {{period === 'month' ? 'active' : ''}}" data-period="month" bindtap="setPeriod">近 30 天</view>
        <view class="seg-item {{period === 'custom' ? 'active' : ''}}" data-period="custom" bindtap="setPeriod">自定义</view>
    </view>

    <!-- 自定义时间范围 -->
    <view class="range-bar" wx:if="{{period === 'custom'}}">
        <picker mode="date" value="{{rangeStart}}" bindchange="onRangeStart">
            <view class="range-pick">{{rangeStart || '开始日期'}} <text class="range-arrow">▾</text></view>
        </picker>
        <text class="range-dash">至</text>
        <picker mode="date" value="{{rangeEnd}}" bindchange="onRangeEnd">
            <view class="range-pick">{{rangeEnd || '结束日期'}} <text class="range-arrow">▾</text></view>
        </picker>
        <text class="range-label" wx:if="{{rangeLabel}}">{{rangeLabel}}</text>
    </view>

        <view class="metrics">
            <view class="metric">
                <view class="num">
                    <roll-number value="{{countText}}" size="44" />
                </view>
                <view class="lbl">次数</view>
            </view>
            <view class="metric">
                <view class="num">
                    <roll-number value="{{avgNum}}" text="{{avgFallback}}" suffix="分" size="44" suffix-size="24" />
                </view>
                <view class="lbl">平均时长</view>
            </view>
            <view class="metric">
                <view class="num">
                    <roll-number value="{{streakText}}" size="44" />
                </view>
                <view class="lbl">连续天数</view>
            </view>
        </view>

        <view class="card">
            <view class="card-title">布里斯托性状分布</view>
            <view wx:if="{{!hasDist}}" class="empty-small">该时段暂无性状数据</view>
            <view class="bar-row" wx:for="{{dist}}" wx:key="key">
                <text class="bar-label">{{item.label}}</text>
                <view class="bar-track">
                    <view class="bar-fill level-{{item.level}}" style="width: {{item.pct}}%;"></view>
                </view>
                <text class="bar-pct">{{item.pct}}%</text>
            </view>
        </view>

        <view class="section-row">
            <text class="section-title">成就墙</text>
            <text class="section-meta">已点亮 {{gotCount}} / 4</text>
        </view>
        <view class="ach-grid">
            <view class="ach {{item.got ? 'got' : ''}}" wx:for="{{achList}}" wx:key="id" data-id="{{item.id}}" bindtap="onBadgeTap">
                <image class="ach-icon" src="{{item.icon}}" mode="aspectFit" />
                <view class="a-name">{{item.name}}</view>
                <view class="a-desc">{{item.desc}}</view>
            </view>
        </view>
</view>

<!-- 分享海报绘制画布（不可见） -->
<canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

<!-- 计时浮条：任意页都能看到还在计时 -->
<timer-bar />
