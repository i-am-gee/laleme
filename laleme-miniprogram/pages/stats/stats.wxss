/* ============================================================
   统计 · iOS 体例
   ============================================================ */

.page {
    padding: 0 var(--sp-4) calc(env(safe-area-inset-bottom) + 170rpx);
}

/* ---------- 分段控件 ---------- */
.seg {
    display: flex;
    gap: 4rpx;
    background: var(--fill-1);
    border-radius: var(--r-sm);
    padding: 4rpx;
    margin: var(--sp-3) 0 var(--sp-3);
}

.seg-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64rpx;
    border-radius: 12rpx;
    font-size: var(--t-footnote);
    color: var(--label);
    transition: background-color 0.2s var(--ease-sheet), box-shadow 0.2s ease;
}

.seg-item.active {
    background: var(--bg-card);
    color: var(--label);
    font-weight: 600;
    box-shadow: 0 1rpx 4rpx rgba(60, 50, 40, 0.10);
}

/* ---------- 自定义时间范围 ---------- */
.range-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-3);
}

.range-pick {
    font-size: var(--t-footnote);
    color: var(--label);
    background: var(--fill-1);
    border-radius: 12rpx;
    padding: 10rpx var(--sp-2);
    font-variant-numeric: tabular-nums;
}

.range-arrow {
    font-size: var(--t-caption2);
    color: var(--label-3);
    margin-left: 4rpx;
}

.range-dash {
    font-size: var(--t-footnote);
    color: var(--label-3);
    flex-shrink: 0;
}

.range-label {
    font-size: var(--t-caption);
    color: var(--label-3);
    margin-left: auto;
}

/* 隐藏分享画布 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}

/* ---------- 三栏指标：一张卡，竖向分隔 ---------- */
.metrics {
    display: flex;
    align-items: stretch;
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-3) 0;
    margin-bottom: var(--sp-2);
}

.metric {
    flex: 1;
    text-align: center;
    animation: metricIn 0.34s var(--ease-sheet) both;
}

.metric + .metric {
    border-left: 0.5rpx solid var(--sep);
}

.metric:nth-child(2) {
    animation-delay: 0.05s;
}

.metric:nth-child(3) {
    animation-delay: 0.1s;
}

@keyframes metricIn {
    0% {
        opacity: 0;
        transform: translateY(10rpx);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 数字容器：接拉霸组件，字号由组件 size 控制 */
.metric .num {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    height: 54rpx;
    font-weight: 600;
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.metric .lbl {
    font-size: var(--t-footnote);
    color: var(--label-2);
    margin-top: 4rpx;
}

/* ---------- 卡片 ---------- */
.card {
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-4);
}

.card-title {
    font-size: var(--t-headline);
    font-weight: 600;
    margin-bottom: var(--sp-3);
    color: var(--label);
}

.empty-small {
    color: var(--label-3);
    font-size: var(--t-footnote);
    text-align: center;
    padding: var(--sp-3) 0;
}

/* ---------- 分布条 ---------- */
.bar-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
}

.bar-row:last-child {
    margin-bottom: 0;
}

.bar-label {
    width: 132rpx;
    font-size: var(--t-caption);
    color: var(--label-2);
    flex-shrink: 0;
}

.bar-track {
    flex: 1;
    height: 20rpx;
    background: var(--fill-1);
    border-radius: var(--r-full);
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: var(--r-full);
    background: var(--tint);
    animation: barGrow 0.5s cubic-bezier(0.32, 0.72, 0, 1) both;
}

@keyframes barGrow {
    0% {
        transform: scaleX(0);
        transform-origin: left center;
    }
    100% {
        transform: scaleX(1);
        transform-origin: left center;
    }
}

.bar-fill.level-bad {
    background: var(--red);
}

.bar-fill.level-warn {
    background: var(--orange);
}

.bar-pct {
    width: 76rpx;
    font-size: var(--t-caption);
    text-align: right;
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
}

/* ---------- 区块标题 ---------- */
.section-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: var(--sp-5) var(--sp-1) var(--sp-2);
}

.section-title {
    font-size: var(--t-title3);
    font-weight: 600;
    color: var(--label);
    letter-spacing: -0.2rpx;
}

.section-meta {
    font-size: var(--t-footnote);
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
}

/* ---------- 成就墙：未点亮凹槽，点亮浮起 ---------- */
.ach-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
}

.ach {
    width: calc(50% - 8rpx);
    box-sizing: border-box;
    background: var(--fill-1);
    border: none;
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-2);
    text-align: center;
    transition: transform 0.2s var(--ease-spring), background-color 0.2s ease;
}

.ach:active {
    transform: scale(0.97);
}

.ach.got {
    background: var(--bg-card);
    box-shadow: 0 4rpx 16rpx rgba(80, 50, 20, 0.08);
}

.ach-icon {
    width: 76rpx;
    height: 76rpx;
    display: block;
    margin: 0 auto 10rpx;
}

.a-name {
    font-size: var(--t-footnote);
    font-weight: 600;
    color: var(--label-2);
}

.ach.got .a-name {
    color: var(--label);
}

.a-desc {
    font-size: var(--t-caption2);
    color: var(--label-3);
    margin-top: 2rpx;
    line-height: 1.4;
}

/* ---------- 挑战入口：与首页共用组件 ---------- */
.cb-area {
    margin-top: var(--sp-5);
}

/* ---------- 好友 PK 入口 ---------- */
.pk-entry {
    margin-top: var(--sp-3);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
}

.pk-entry-press {
    background: var(--fill-1);
}

.pk-entry-main {
    flex: 1;
    min-width: 0;
}

.pk-entry-t {
    font-size: var(--t-headline);
    font-weight: 600;
    color: var(--label);
}

.pk-entry-d {
    margin-top: 6rpx;
    font-size: var(--t-caption);
    color: var(--label-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ---------- 段位卡：只看连续天数，断签掉级 ---------- */
.rank-card {
    padding: var(--sp-4);
    margin-top: var(--sp-3);
}

.rk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
}

/* 当前段位的便便图标，与首页大按钮同一张图 */
.rk-badge {
    flex: none;
    width: 104rpx;
    height: 104rpx;
}

.rk-main {
    flex: 1;
    min-width: 0;
}

.rk-name {
    display: block;
    font-size: var(--t-title3);
    font-weight: 600;
    color: var(--label);
    letter-spacing: 1rpx;
}

.rk-sub {
    display: block;
    margin-top: 6rpx;
    font-size: var(--t-footnote);
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
}

.rk-peak {
    flex-shrink: 0;
    padding-top: 8rpx;
    font-size: var(--t-caption);
    color: var(--label-3);
}

.rk-track {
    height: 10rpx;
    margin-top: var(--sp-3);
    border-radius: var(--r-full);
    background: var(--fill-1);
    overflow: hidden;
}

.rk-fill {
    height: 100%;
    border-radius: var(--r-full);
    background: linear-gradient(90deg, #b8893c, #e9cb80);
    transition: width 0.45s var(--ease-sheet);
}

.rk-next {
    margin-top: 10rpx;
    font-size: var(--t-caption);
    color: var(--label-2);
}

.rk-ladder {
    display: flex;
    align-items: flex-start;
    margin-top: var(--sp-3);
}

/* 一列一个里程碑：圆点居中，天数与段位简称在下面 —— 只看天数，与质量无关 */
.rk-step {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rpx;
}

.rk-line {
    position: absolute;
    top: 26rpx;
    left: 50%;
    right: -50%;
    height: 2rpx;
    background: var(--label-4);
}

.rk-step.on .rk-line {
    background: var(--tint-fill);
}

.rk-rail {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52rpx;
}

/* 未解锁：压暗但保留轮廓，让人看得见下一档长什么样 */
.rk-icon {
    width: 48rpx;
    height: 48rpx;
    opacity: 0.32;
    transition: opacity 0.25s ease, transform 0.25s var(--ease-spring);
}

.rk-step.on .rk-icon {
    opacity: 1;
}

.rk-step.cur .rk-icon {
    transform: scale(1.16);
}

.rk-day {
    margin-top: 4rpx;
    font-size: 20rpx;
    line-height: 1.2;
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
}

.rk-step.on .rk-day {
    color: var(--label);
}

.rk-brief {
    font-size: 20rpx;
    line-height: 1.2;
    color: var(--label-3);
}

.rk-step.on .rk-brief {
    color: var(--label-2);
}

.rk-step.cur .rk-day,
.rk-step.cur .rk-brief {
    color: var(--tint-strong);
    font-weight: 500;
}
.rk-hint {
    margin-top: var(--sp-2);
    font-size: var(--t-caption2);
    color: var(--label-3);
    line-height: 1.55;
}
