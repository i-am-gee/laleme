.page {
    padding: 24rpx 32rpx 60rpx;
}

.seg {
    display: flex;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 20rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
}

.seg-item {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 28rpx;
    color: #888780;
}

.seg-item.active {
    background: #8b5e3c;
    color: #ffffff;
    font-weight: 600;
}

/* 自定义时间范围 */
.range-bar {
    display: flex;
    align-items: center;
    gap: 12rpx;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 20rpx;
    padding: 16rpx 20rpx;
    margin-bottom: 24rpx;
}

.range-pick {
    font-size: 26rpx;
    color: #5c4a38;
    background: #f7f4ef;
    border-radius: 14rpx;
    padding: 10rpx 18rpx;
}

.range-arrow {
    font-size: 22rpx;
    color: #9b8f7d;
    margin-left: 4rpx;
}

.range-dash {
    font-size: 26rpx;
    color: #888780;
    flex-shrink: 0;
}

.range-label {
    font-size: 24rpx;
    color: #9b8f7d;
    margin-left: auto;
}

/* 隐藏分享画布 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}

.metrics {
    display: flex;
    gap: 16rpx;
    margin-bottom: 24rpx;
}

.metric {
    flex: 1;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 24rpx;
    padding: 26rpx 8rpx;
    text-align: center;
}

.metric .num {
    font-size: 40rpx;
    font-weight: 700;
    color: #8b5e3c;
}

.metric .lbl {
    font-size: 23rpx;
    color: #888780;
    margin-top: 4rpx;
}

.card {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
    padding: 30rpx;
}

.card-title {
    font-size: 29rpx;
    font-weight: 600;
    margin-bottom: 22rpx;
}

.empty-small {
    color: #888780;
    font-size: 26rpx;
    text-align: center;
    padding: 20rpx 0;
}

.bar-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 16rpx;
}

.bar-row:last-child {
    margin-bottom: 0;
}

.bar-label {
    width: 128rpx;
    font-size: 24rpx;
    flex-shrink: 0;
}

.bar-track {
    flex: 1;
    height: 22rpx;
    background: #f1efe8;
    border-radius: 11rpx;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: 11rpx;
    background: #8b5e3c;
}

.bar-fill.level-bad {
    background: #e24b4a;
}

.bar-fill.level-warn {
    background: #ba7517;
}

.bar-pct {
    width: 76rpx;
    font-size: 24rpx;
    text-align: right;
    color: #888780;
}

.section-title {
    font-size: 29rpx;
    font-weight: 600;
    margin: 32rpx 0 18rpx;
}

.ach-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.ach {
    width: calc(50% - 8rpx);
    box-sizing: border-box;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 24rpx;
    padding: 26rpx;
    text-align: center;
    opacity: 0.45;
}

.ach.got {
    opacity: 1;
    background: #faeeda;
    border-color: #854f0b;
}

.a-name {
    font-size: 27rpx;
    font-weight: 600;
}

.a-desc {
    font-size: 23rpx;
    color: #888780;
    margin-top: 6rpx;
}

.share-btn {
    background: linear-gradient(135deg, #a97750 0%, #8b5e3c 55%, #6f4b30 100%);
    color: #ffffff;
    font-size: 34rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
    height: 104rpx;
    line-height: 104rpx;
    padding: 0;
    width: 100% !important;
    box-sizing: border-box;
    border-radius: 52rpx;
    margin-top: 32rpx;
    box-shadow: 0 12rpx 28rpx rgba(139, 94, 60, 0.3);
}

.share-btn::after {
    border: none;
}
