.page {
    padding: 24rpx 32rpx 60rpx;
}

.seg {
    display: flex;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 20rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
}

.seg-item {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 28rpx;
    color: #888780;
}

.seg-item.active {
    background: #8b5e3c;
    color: #ffffff;
    font-weight: 600;
}

.metrics {
    display: flex;
    gap: 16rpx;
    margin-bottom: 24rpx;
}

.metric {
    flex: 1;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 24rpx;
    padding: 26rpx 8rpx;
    text-align: center;
}

.metric .num {
    font-size: 40rpx;
    font-weight: 700;
    color: #8b5e3c;
}

.metric .lbl {
    font-size: 23rpx;
    color: #888780;
    margin-top: 4rpx;
}

.card {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
    padding: 30rpx;
}

.card-title {
    font-size: 29rpx;
    font-weight: 600;
    margin-bottom: 22rpx;
}

.empty-small {
    color: #888780;
    font-size: 26rpx;
    text-align: center;
    padding: 20rpx 0;
}

.bar-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 16rpx;
}

.bar-row:last-child {
    margin-bottom: 0;
}

.bar-label {
    width: 128rpx;
    font-size: 24rpx;
    flex-shrink: 0;
}

.bar-track {
    flex: 1;
    height: 22rpx;
    background: #f1efe8;
    border-radius: 11rpx;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: 11rpx;
    background: #8b5e3c;
}

.bar-fill.level-bad {
    background: #e24b4a;
}

.bar-fill.level-warn {
    background: #ba7517;
}

.bar-pct {
    width: 76rpx;
    font-size: 24rpx;
    text-align: right;
    color: #888780;
}

.section-title {
    font-size: 29rpx;
    font-weight: 600;
    margin: 32rpx 0 18rpx;
}

.ach-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.ach {
    width: calc(50% - 8rpx);
    box-sizing: border-box;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 24rpx;
    padding: 26rpx;
    text-align: center;
    opacity: 0.45;
}

.ach.got {
    opacity: 1;
    background: #faeeda;
    border-color: #854f0b;
}

.a-name {
    font-size: 27rpx;
    font-weight: 600;
}

.a-desc {
    font-size: 23rpx;
    color: #888780;
    margin-top: 6rpx;
}

.share-btn {
    background: #8b5e3c;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    margin-top: 32rpx;
}
