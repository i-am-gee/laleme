.page {
    padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 130rpx);
}

.seg {
    display: flex;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 20rpx;
    overflow: hidden;
    margin-bottom: 22rpx;
}

.seg-item {
    flex: 1;
    text-align: center;
    padding: 18rpx 0;
    font-size: 27rpx;
    color: #888780;
    transition: background 0.18s, color 0.18s;
}

.seg-item.active {
    background: #8b5e3c;
    color: #ffffff;
    font-weight: 600;
}

/* 自定义时间范围 */
.range-bar {
    display: flex;
    align-items: center;
    gap: 12rpx;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 20rpx;
    padding: 15rpx 20rpx;
    margin-bottom: 22rpx;
}

.range-pick {
    font-size: 26rpx;
    color: #5c4a38;
    background: #f7f4ef;
    border-radius: 14rpx;
    padding: 8rpx 16rpx;
}

.range-arrow {
    font-size: 22rpx;
    color: #9b8f7d;
    margin-left: 4rpx;
}

.range-dash {
    font-size: 26rpx;
    color: #888780;
    flex-shrink: 0;
}

.range-label {
    font-size: 23rpx;
    color: #9b8f7d;
    margin-left: auto;
}

/* 隐藏分享画布 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}

.metrics {
    display: flex;
    gap: 16rpx;
    margin-bottom: 22rpx;
}

.metric {
    flex: 1;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 24rpx;
    padding: 24rpx 8rpx;
    text-align: center;
    animation: metricIn 0.32s ease-out both;
}

.metric:nth-child(2) {
    animation-delay: 0.05s;
}

.metric:nth-child(3) {
    animation-delay: 0.1s;
}

@keyframes metricIn {
    0% { opacity: 0; transform: translateY(12rpx); }
    100% { opacity: 1; transform: translateY(0); }
}

.metric .num {
    font-size: 40rpx;
    font-weight: 700;
    color: #8b5e3c;
}

.metric .lbl {
    font-size: 23rpx;
    color: #888780;
    margin-top: 4rpx;
}

.card {
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 28rpx;
    padding: 30rpx;
}

.card-title {
    font-size: 29rpx;
    font-weight: 600;
    margin-bottom: 22rpx;
}

.empty-small {
    color: #888780;
    font-size: 26rpx;
    text-align: center;
    padding: 20rpx 0;
}

.bar-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 16rpx;
}

.bar-row:last-child {
    margin-bottom: 0;
}

.bar-label {
    width: 128rpx;
    font-size: 24rpx;
    flex-shrink: 0;
}

.bar-track {
    flex: 1;
    height: 22rpx;
    background: #f1efe8;
    border-radius: 11rpx;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: 11rpx;
    background: #8b5e3c;
    animation: barGrow 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes barGrow {
    0% { transform: scaleX(0); transform-origin: left center; }
    100% { transform: scaleX(1); transform-origin: left center; }
}

.bar-fill.level-bad {
    background: #e24b4a;
}

.bar-fill.level-warn {
    background: #ba7517;
}

.bar-pct {
    width: 76rpx;
    font-size: 24rpx;
    text-align: right;
    color: #888780;
}

.section-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 30rpx 0 16rpx;
}

.section-title {
    font-size: 29rpx;
    font-weight: 600;
}

.section-meta {
    font-size: 22rpx;
    color: #a3978a;
}

.ach-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.ach {
    width: calc(50% - 8rpx);
    box-sizing: border-box;
    background: #ffffff;
    border: 0.5rpx solid rgba(44, 44, 42, 0.12);
    border-radius: 24rpx;
    padding: 22rpx 16rpx 20rpx;
    text-align: center;
    transition: transform 0.12s ease;
}

.ach.got {
    background: #fdf7ef;
    border-color: rgba(139, 94, 60, 0.32);
    box-shadow: 0 8rpx 22rpx rgba(139, 94, 60, 0.12);
}

.ach-icon {
    width: 76rpx;
    height: 76rpx;
    display: block;
    margin: 0 auto 10rpx;
}

.a-name {
    font-size: 26rpx;
    font-weight: 600;
    color: #2c2c2a;
}

.ach.got .a-name {
    color: #8b5e3c;
}

.a-desc {
    font-size: 21rpx;
    color: #a3978a;
    margin-top: 4rpx;
}

.share-btn {
    background: linear-gradient(135deg, #a97750 0%, #8b5e3c 55%, #6f4b30 100%);
    color: #ffffff;
    font-size: 33rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
    height: 100rpx;
    line-height: 100rpx;
    padding: 0;
    width: 100% !important;
    box-sizing: border-box;
    border-radius: 50rpx;
    margin-top: 30rpx;
    box-shadow: 0 12rpx 28rpx rgba(139, 94, 60, 0.3);
}

.share-btn::after {
    border: none;
}
