/* ============================================================
   统计 · iOS 体例
   ============================================================ */

.page {
    padding: 0 var(--sp-4) calc(env(safe-area-inset-bottom) + 170rpx);
}

/* ---------- 分段控件 ---------- */
.seg {
    display: flex;
    gap: 4rpx;
    background: var(--fill-1);
    border-radius: var(--r-sm);
    padding: 4rpx;
    margin: var(--sp-3) 0 var(--sp-3);
}

.seg-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64rpx;
    border-radius: 12rpx;
    font-size: var(--t-footnote);
    color: var(--label);
    transition: background-color 0.2s var(--ease-sheet), box-shadow 0.2s ease;
}

.seg-item.active {
    background: var(--bg-card);
    color: var(--label);
    font-weight: 600;
    box-shadow: 0 1rpx 4rpx rgba(60, 50, 40, 0.10);
}

/* ---------- 自定义时间范围 ---------- */
.range-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-3);
}

.range-pick {
    font-size: var(--t-footnote);
    color: var(--label);
    background: var(--fill-1);
    border-radius: 12rpx;
    padding: 10rpx var(--sp-2);
    font-variant-numeric: tabular-nums;
}

.range-arrow {
    font-size: var(--t-caption2);
    color: var(--label-3);
    margin-left: 4rpx;
}

.range-dash {
    font-size: var(--t-footnote);
    color: var(--label-3);
    flex-shrink: 0;
}

.range-label {
    font-size: var(--t-caption);
    color: var(--label-3);
    margin-left: auto;
}

/* 隐藏分享画布 */
.share-canvas {
    position: fixed;
    left: -9999rpx;
    top: -9999rpx;
    width: 500px;
    height: 400px;
}

/* ---------- 三栏指标：一张卡，竖向分隔 ---------- */
.metrics {
    display: flex;
    align-items: stretch;
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-3) 0;
    margin-bottom: var(--sp-2);
}

.metric {
    flex: 1;
    text-align: center;
    animation: metricIn 0.34s var(--ease-sheet) both;
}

.metric + .metric {
    border-left: 0.5rpx solid var(--sep);
}

.metric:nth-child(2) {
    animation-delay: 0.05s;
}

.metric:nth-child(3) {
    animation-delay: 0.1s;
}

@keyframes metricIn {
    0% {
        opacity: 0;
        transform: translateY(10rpx);
    }
    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

/* 数字容器：接拉霸组件，字号由组件 size 控制 */
.metric .num {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    height: 54rpx;
    font-weight: 600;
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.metric .lbl {
    font-size: var(--t-footnote);
    color: var(--label-2);
    margin-top: 4rpx;
}

/* ---------- 卡片 ---------- */
.card {
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-4);
}

.card-title {
    font-size: var(--t-headline);
    font-weight: 600;
    margin-bottom: var(--sp-3);
    color: var(--label);
}

.empty-small {
    color: var(--label-3);
    font-size: var(--t-footnote);
    text-align: center;
    padding: var(--sp-3) 0;
}

/* ---------- 分布条 ---------- */
.bar-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
}

.bar-row:last-child {
    margin-bottom: 0;
}

.bar-label {
    width: 132rpx;
    font-size: var(--t-caption);
    color: var(--label-2);
    flex-shrink: 0;
}

.bar-track {
    flex: 1;
    height: 20rpx;
    background: var(--fill-1);
    border-radius: var(--r-full);
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    border-radius: var(--r-full);
    background: var(--tint);
    animation: barGrow 0.5s cubic-bezier(0.32, 0.72, 0, 1) both;
}

@keyframes barGrow {
    0% {
        transform: scaleX(0);
        transform-origin: left center;
    }
    100% {
        transform: scaleX(1);
        transform-origin: left center;
    }
}

.bar-fill.level-bad {
    background: var(--red);
}

.bar-fill.level-warn {
    background: var(--orange);
}

.bar-pct {
    width: 76rpx;
    font-size: var(--t-caption);
    text-align: right;
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
}

/* ---------- 区块标题 ---------- */
.section-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: var(--sp-5) var(--sp-1) var(--sp-2);
}

.section-title {
    font-size: var(--t-title3);
    font-weight: 600;
    color: var(--label);
    letter-spacing: -0.2rpx;
}

.section-meta {
    font-size: var(--t-footnote);
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
}

/* ---------- 成就墙：未点亮凹槽，点亮浮起 ---------- */
.ach-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
}

.ach {
    width: calc(50% - 8rpx);
    box-sizing: border-box;
    background: var(--fill-1);
    border: none;
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-2);
    text-align: center;
    transition: transform 0.2s var(--ease-spring), background-color 0.2s ease;
}

.ach:active {
    transform: scale(0.97);
}

.ach.got {
    background: var(--bg-card);
    box-shadow: 0 4rpx 16rpx rgba(80, 50, 20, 0.08);
}

.ach-icon {
    width: 76rpx;
    height: 76rpx;
    display: block;
    margin: 0 auto 10rpx;
}

.a-name {
    font-size: var(--t-footnote);
    font-weight: 600;
    color: var(--label-2);
}

.ach.got .a-name {
    color: var(--label);
}

.a-desc {
    font-size: var(--t-caption2);
    color: var(--label-3);
    margin-top: 2rpx;
    line-height: 1.4;
}

/* ---------- 挑战入口：与首页共用组件 ---------- */
.cb-area {
    margin-top: var(--sp-5);
}

/* ---------- 好友 PK 入口 ---------- */
.pk-entry {
    margin-top: var(--sp-4);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
}

.pk-entry-press {
    background: var(--fill-1);
}

.pk-entry-main {
    flex: 1;
    min-width: 0;
}

.pk-entry-t {
    font-size: var(--t-headline);
    font-weight: 600;
    color: var(--label);
}

.pk-entry-d {
    margin-top: 6rpx;
    font-size: var(--t-caption);
    color: var(--label-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ---------- 每天几次 ---------- */
.daily-card {
    margin-top: var(--sp-4);
}

.daily-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-2);
}

.daily-title {
    margin-bottom: 0;
}

.daily-sub {
    font-size: var(--t-caption);
    color: var(--label-3);
}

.daily-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 14rpx 0;
    border-bottom: 0.5rpx solid var(--sep);
}

.daily-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.daily-day {
    width: 92rpx;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.daily-date {
    font-size: var(--t-footnote);
    color: var(--label);
    font-variant-numeric: tabular-nums;
}

.daily-wd {
    font-size: 20rpx;
    color: var(--label-3);
    line-height: 1.3;
}

.daily-shots {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8rpx;
}

.shot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rpx;
}

.shot-icon {
    width: 44rpx;
    height: 44rpx;
}

/* 没填形状时用一个空心圆占位，保持行高一致 */
.shot-empty {
    width: 44rpx;
    height: 44rpx;
    border-radius: var(--r-full);
    background: var(--fill-1);
}

/* 颜色放在图标下方：不与剪影打架，读起来是「形状 + 颜色」一对 */
.shot-bar {
    width: 28rpx;
    height: 8rpx;
    border-radius: var(--r-full);
    /* 浅色（黄褐、黄绿）在白卡上也要看得见 */
    box-shadow: inset 0 0 0 1rpx rgba(60, 40, 20, 0.12);
}

.shot-more {
    font-size: 20rpx;
    color: var(--label-3);
    margin-left: 2rpx;
}

.shot-none {
    font-size: var(--t-caption);
    color: var(--label-4);
}

.daily-n {
    width: 56rpx;
    text-align: right;
    font-size: var(--t-subhead);
    font-weight: 600;
    color: var(--label-2);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
}
