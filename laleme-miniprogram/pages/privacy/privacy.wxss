/* ============================================================
   隐私保护指引 · iOS 阅读体例
   ============================================================ */

.page {
    padding: var(--sp-3) var(--sp-4) var(--sp-6);
}

.doc-card {
    background: var(--bg-card);
    border-radius: var(--r-lg);
    padding: var(--sp-5) var(--sp-4);
}

.doc-title {
    font-size: var(--t-title2);
    font-weight: 600;
    margin-bottom: var(--sp-3);
    letter-spacing: -0.3rpx;
    color: var(--label);
}

.para {
    font-size: var(--t-footnote);
    color: var(--label-2);
    line-height: 1.8;
    margin-bottom: var(--sp-2);
}

.para.meta {
    font-size: var(--t-caption);
    color: var(--label-3);
}

.para.heading {
    font-weight: 600;
    color: var(--label);
    margin-top: var(--sp-4);
}

.tip {
    display: block;
    text-align: center;
    color: var(--tint);
    font-size: var(--t-subhead);
    padding: var(--sp-4) 0;
}
